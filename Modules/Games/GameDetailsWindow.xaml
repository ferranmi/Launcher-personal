<Window x:Class="Launcher.Modules.Games.GameDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Launcher.Core.Converters"
        Title="Informacion del juego"
        Height="780" Width="900"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:UrlToBitmapConverter x:Key="UrlToBitmap" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentDim}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="SmallDangerButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
        </Style>

        <Style x:Key="WinBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Rectangle x:Name="PART_Indicator"
                                           Fill="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Left"
                                           RadiusX="3" RadiusY="3" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Achieved}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Background}"
            BorderBrush="{DynamicResource Brush.BorderStrong}"
            BorderThickness="1" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.6" />
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===================== BARRA SUPERIOR ===================== -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <TextBlock Text="&gt; informacion_"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="14"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           VerticalAlignment="Center" />
                <Button Content="&#xE8BB;" Style="{StaticResource WindowButtonStyle}"
                        HorizontalAlignment="Right" Click="Close_Click" />
            </Grid>

            <!-- ===================== CABECERA DEL JUEGO ===================== -->
            <Grid Grid.Row="1" Margin="0,14,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="96" Height="144" CornerRadius="8" ClipToBounds="True"
                        Background="{DynamicResource Brush.SurfaceActive}">
                    <Grid>
                        <TextBlock x:Name="CoverInitial" FontFamily="{DynamicResource Font.Mono}"
                                   FontSize="38" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.TextDim}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="CoverImage" Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold"
                               TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextPrimary}" />
                    <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" TextWrapping="Wrap"
                               FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBlock x:Name="StatsText" Margin="0,6,0,0"
                               FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                               Foreground="{DynamicResource Brush.TextDim}" />

                    <WrapPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Jugar" Style="{StaticResource AccentButton}"
                                Padding="26,9" Margin="0,0,8,6" Click="Play_Click" />
                        <Button x:Name="OpenFolderButton" Content="Abrir carpeta"
                                Style="{StaticResource GhostButton}" Padding="14,9" Margin="0,0,8,6"
                                ToolTip="Abre la carpeta de instalacion del juego"
                                Click="OpenFolder_Click" />
                        <Button x:Name="ManageButton" Content="Gestionar"
                                Style="{StaticResource GhostButton}" Padding="14,9" Margin="0,0,8,6"
                                ToolTip="Ejecutar como administrador, editar, favorito, ocultar, eliminar"
                                Click="Manage_Click" />
                        <Button x:Name="StoreButton" Content="Abrir en la tienda"
                                Style="{StaticResource GhostButton}" Padding="14,9" Margin="0,0,0,6"
                                Click="OpenStore_Click" />
                    </WrapPanel>
                </StackPanel>
            </Grid>

            <!-- ===================== PESTANAS ===================== -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
                <RadioButton x:Name="TabInfo" Content="Informacion" Tag="Info" GroupName="DetailsTab"
                             Style="{StaticResource ChipStyle}" IsChecked="True" Checked="Tab_Checked" />
                <RadioButton x:Name="TabAchievements" Content="Logros" Tag="Achievements" GroupName="DetailsTab"
                             Style="{StaticResource ChipStyle}" Checked="Tab_Checked" />
                <RadioButton x:Name="TabLinks" Content="Enlaces y documentos" Tag="Links" GroupName="DetailsTab"
                             Style="{StaticResource ChipStyle}" Checked="Tab_Checked" />
                <RadioButton x:Name="TabNotes" Content="Notas" Tag="Notes" GroupName="DetailsTab"
                             Style="{StaticResource ChipStyle}" Checked="Tab_Checked" />
            </StackPanel>

            <!-- ===================== CONTENIDO ===================== -->
            <Grid Grid.Row="3">

                <!-- ===== INFORMACION ===== -->
                <ScrollViewer x:Name="InfoPanel" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Descripcion" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="DescriptionBox" Style="{StaticResource FieldBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Height="100" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Generos" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="GenresBox" Style="{StaticResource FieldBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Desarrollador" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="DevelopersBox" Style="{StaticResource FieldBox}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Editor" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="PublishersBox" Style="{StaticResource FieldBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Fecha de salida" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ReleaseBox" Style="{StaticResource FieldBox}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ID del juego en Steam" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SteamIdBox" Style="{StaticResource FieldBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Puntuacion" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="ScoreText" Margin="0,7,0,0"
                                           FontFamily="{DynamicResource Font.Mono}" FontSize="12"
                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button x:Name="RefreshInfoButton" Content="Actualizar informacion"
                                    Style="{StaticResource GhostButton}" Click="RefreshInfo_Click" />
                        </StackPanel>
                        <TextBlock x:Name="InfoSourceText" Margin="0,0,0,16" TextWrapping="Wrap"
                                   FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                   Foreground="{DynamicResource Brush.TextDim}" />

                        <TextBlock x:Name="ScreenshotsLabel" Text="Capturas" Style="{StaticResource FieldLabel}" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ScreenshotsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,10,10" CornerRadius="6" ClipToBounds="True"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                Cursor="Hand" ToolTip="Abrir en grande"
                                                MouseLeftButtonUp="Screenshot_Click">
                                            <Image Source="{Binding ThumbUrl, Converter={StaticResource UrlToBitmap}, ConverterParameter=320}"
                                                   Width="200" Height="113" Stretch="UniformToFill" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== LOGROS ===== -->
                <Grid x:Name="AchievementsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="AchievementsMessage" TextWrapping="Wrap"
                                   FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="ConfigureSteamButton" Content="Configurar cuenta de Steam"
                                    Style="{StaticResource AccentButton}" Margin="0,0,8,0"
                                    Visibility="Collapsed" Click="ConfigureSteam_Click" />
                            <Button x:Name="RefreshAchievementsButton" Content="Actualizar logros"
                                    Style="{StaticResource GhostButton}" Click="RefreshAchievements_Click" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="AchievementsSummaryPanel" Grid.Row="1" Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock x:Name="AchievementsSummary" Margin="0,0,0,6"
                                   FontFamily="{DynamicResource Font.Mono}" FontSize="12"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                        <ProgressBar x:Name="AchievementsBar" Style="{StaticResource WinBar}"
                                     Minimum="0" Maximum="100" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AchievementsList" Margin="0,0,10,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,8"
                                            Opacity="{Binding RowOpacity}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Image Source="{Binding ShownIcon, Converter={StaticResource UrlToBitmap}, ConverterParameter=96}"
                                                   Width="44" Height="44" Stretch="UniformToFill"
                                                   VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                                                <TextBlock Text="{Binding DescriptionText}" Margin="0,2,0,0"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusValue}" />
                                                <TextBlock Text="{Binding PercentText}" Margin="0,3,0,0"
                                                           HorizontalAlignment="Right"
                                                           FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                                           Foreground="{DynamicResource Brush.TextDim}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ===== ENLACES Y DOCUMENTOS ===== -->
                <ScrollViewer x:Name="LinksPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">

                        <!-- Formulario de enlace (anadir / editar) -->
                        <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="LinkFormTitle" Text="Anadir enlace" Style="{StaticResource FieldLabel}" />

                                <TextBlock Text="Titulo (opcional)" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                                <TextBox x:Name="LinkTitleBox" Style="{StaticResource FieldBox}" />

                                <TextBlock Text="Direccion (URL)" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                                <TextBox x:Name="LinkUrlBox" Style="{StaticResource FieldBox}" />

                                <TextBlock Text="Abrir con" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                                <ComboBox x:Name="BrowserCombo" DisplayMemberPath="Name"
                                          SelectionChanged="BrowserCombo_SelectionChanged" />

                                <StackPanel x:Name="IncognitoPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                    <CheckBox x:Name="LinkIncognitoCheck" Content="Abrir en ventana privada (incognito)"
                                              Foreground="{DynamicResource Brush.TextSecondary}"
                                              FontFamily="{DynamicResource Font.Mono}" FontSize="11" />
                                    <TextBlock x:Name="IncognitoHint" Margin="0,4,0,0"
                                               FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                               Foreground="{DynamicResource Brush.TextDim}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="SaveLinkButton" Content="Anadir"
                                            Style="{StaticResource AccentButton}" Margin="0,0,8,0"
                                            Click="SaveLink_Click" />
                                    <Button x:Name="CancelEditButton" Content="Cancelar edicion"
                                            Style="{StaticResource GhostButton}" Visibility="Collapsed"
                                            Click="CancelEdit_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Lista de enlaces -->
                        <TextBlock Text="ENLACES" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <ItemsControl x:Name="LinksList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                                                <TextBlock Text="{Binding Url}" Margin="0,2,0,0"
                                                           FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Brush.TextDim}" />
                                                <TextBlock Text="{Binding BrowserLabel}" Margin="0,2,0,0"
                                                           FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Button Content="Abrir" Style="{StaticResource SmallButton}" Margin="0,0,6,0" Click="LinkOpen_Click" />
                                                <Button Content="Editar" Style="{StaticResource SmallButton}" Margin="0,0,6,0" Click="LinkEdit_Click" />
                                                <Button Content="Quitar" Style="{StaticResource SmallDangerButton}" Click="LinkRemove_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="LinksEmpty" Text="&gt; sin enlaces_" Margin="0,0,0,8"
                                   FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                                   Foreground="{DynamicResource Brush.TextDim}" />

                        <!-- Documentos locales -->
                        <Grid Margin="0,14,0,8">
                            <TextBlock Text="DOCUMENTOS Y CARPETAS" Style="{StaticResource SectionTitle}"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Anadir archivo..." Style="{StaticResource SmallButton}"
                                        Margin="0,0,6,0" Click="AddFile_Click" />
                                <Button Content="Anadir carpeta..." Style="{StaticResource SmallButton}"
                                        Click="AddFolder_Click" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl x:Name="DocumentsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Icon}" FontFamily="{DynamicResource Font.Icons}"
                                                       FontSize="16" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Accent}" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                                                <TextBlock Text="{Binding Path}" Margin="0,2,0,0"
                                                           FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Brush.TextDim}" />
                                                <TextBlock Text="no encontrado" Margin="0,2,0,0"
                                                           FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                                           Foreground="{DynamicResource Brush.Danger}"
                                                           Visibility="{Binding Exists, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Button Content="Abrir" Style="{StaticResource SmallButton}" Margin="0,0,6,0" Click="DocOpen_Click" />
                                                <Button Content="Quitar" Style="{StaticResource SmallDangerButton}" Click="DocRemove_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="DocumentsEmpty" Text="&gt; sin documentos_" Margin="0,0,0,8"
                                   FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                                   Foreground="{DynamicResource Brush.TextDim}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== NOTAS ===== -->
                <Grid x:Name="NotesPanel" Visibility="Collapsed">
                    <TextBox x:Name="NotesBox" Style="{StaticResource FieldBox}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                </Grid>
            </Grid>

            <!-- ===================== ESTADO ===================== -->
            <TextBlock Grid.Row="4" x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                       FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                       Foreground="{DynamicResource Brush.TextDim}" />
        </Grid>
    </Border>
</Window>
