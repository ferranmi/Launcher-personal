<Window x:Class="Launcher.Modules.Games.SteamAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cuenta de Steam"
        Height="470" Width="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentDim}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Background}"
            BorderBrush="{DynamicResource Brush.BorderStrong}"
            BorderThickness="1" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.6" />
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="&gt; Cuenta de Steam"
                       FontFamily="{DynamicResource Font.Mono}" FontSize="16"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       Margin="0,0,0,12" MouseLeftButtonDown="Header_MouseLeftButtonDown" />

            <StackPanel Grid.Row="1">
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                           Foreground="{DynamicResource Brush.TextDim}"
                           Text="Para ver tus logros, Steam pide una clave gratuita de su Web API. Se crea en steamcommunity.com/dev/apikey (en 'Domain name' vale cualquier texto, p. ej. localhost). Steam no la da a las cuentas limitadas (las que aun no han gastado 5 USD/EUR). Ademas, los detalles de juego de tu perfil deben estar en publico." />

                <TextBlock Text="Clave de la Web API" Style="{StaticResource FieldLabel}" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ApiKeyBox" Grid.Column="0" Style="{StaticResource FieldBox}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="Obtener clave" Style="{StaticResource GhostButton}" Click="GetKey_Click" />
                </Grid>
                <TextBlock Text="32 caracteres (letras A-F y numeros)" Margin="0,0,0,18"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                           Foreground="{DynamicResource Brush.TextDim}" />

                <TextBlock Text="SteamID64" Style="{StaticResource FieldLabel}" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SteamIdBox" Grid.Column="0" Style="{StaticResource FieldBox}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="Detectar" Style="{StaticResource GhostButton}" Click="Detect_Click" />
                </Grid>
                <TextBlock Text="17 digitos. 'Detectar' lo lee de tu instalacion local de Steam."
                           FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                           Foreground="{DynamicResource Brush.TextDim}" />

                <TextBlock Text="La clave se guarda en texto plano en %AppData%\Launcher\settings.json."
                           Margin="0,18,0,0" TextWrapping="Wrap"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                           Foreground="{DynamicResource Brush.TextDim}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancelar" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="Guardar" Style="{StaticResource AccentButton}" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
