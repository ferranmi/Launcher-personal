<Window x:Class="Launcher.Modules.Media.AddEditMediaAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="App multimedia"
        Height="440" Width="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentDim}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Background}"
            BorderBrush="{DynamicResource Brush.BorderStrong}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.6" />
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="HeaderText" Grid.Row="0" Text="&gt; Anadir app"
                       FontFamily="{DynamicResource Font.Mono}" FontSize="16"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       Margin="0,0,0,18" MouseLeftButtonDown="Header_MouseLeftButtonDown" />

            <StackPanel Grid.Row="1">
                <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}" Margin="0,0,0,14" />

                <TextBlock Text="Ejecutable" Style="{StaticResource FieldLabel}" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" Grid.Column="0" Style="{StaticResource FieldBox}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="..." Style="{StaticResource GhostButton}" Width="34" Click="BrowseExecutable_Click" />
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Detectar desde una carpeta"
                            ToolTip="Busca el .exe principal en la carpeta y usa su icono"
                            Style="{StaticResource GhostButton}"
                            HorizontalContentAlignment="Left"
                            Click="DetectFromFolder_Click" />
                    <TextBlock x:Name="FolderDetectStatus" Grid.Column="1"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                               Foreground="{DynamicResource Brush.TextDim}" />
                </Grid>

                <TextBlock Text="Argumentos (opcional)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ArgumentsBox" Style="{StaticResource FieldBox}" Margin="0,0,0,14" />

                <TextBlock Text="Icono (opcional)" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="IconBox" Grid.Column="0" Style="{StaticResource FieldBox}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="..." Style="{StaticResource GhostButton}" Width="34" Click="BrowseIcon_Click" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancelar" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="Guardar" Style="{StaticResource AccentButton}" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
