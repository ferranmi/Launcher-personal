<UserControl x:Class="Launcher.Modules.Media.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Launcher.Core.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:PlayPauseGlyphConverter x:Key="PlayPauseGlyph" />

        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Icons}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="23">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButtonStyle" TargetType="Button" BasedOn="{StaticResource TransportButtonStyle}">
            <Setter Property="Width" Value="60" />
            <Setter Property="Height" Value="60" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="Foreground" Value="#FF07130D" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Effect" Value="{DynamicResource Effect.AccentGlow}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="30">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider minimalista estilo terminal: track fino, relleno verde, thumb circular.
             Reutilizado tanto para el progreso de la cancion como para cada volumen del mezclador. -->
        <Style x:Key="MinimalSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="16" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource Brush.Accent}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource Brush.Border}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource Brush.Accent}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Boton de mute: icono de altavoz que se tacha cuando IsMuted es true -->
        <Style x:Key="MuteToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Icons}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Content" Value="&#xE767;" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Content" Value="&#xE74F;" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <!-- ===================== REPRODUCTOR (Now Playing) ===================== -->
        <Grid Grid.Column="0">

            <!-- NowPlayingContent envuelve todo lo que depende de la cancion actual
                 (caratula, titulo, artista, badge) para poder animar un fundido
                 cuando NowPlayingService detecta un cambio de pista/video. -->
            <Grid x:Name="NowPlayingContent">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                            Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}">

                    <Border Width="240" Height="240" CornerRadius="12" ClipToBounds="True"
                            HorizontalAlignment="Center"
                            Cursor="Hand" ToolTip="Doble clic para abrir la app"
                            MouseLeftButtonDown="SourceBadge_MouseLeftButtonDown">
                        <Border.Background>
                            <RadialGradientBrush>
                                <GradientStop Color="{DynamicResource Color.AccentDim}" Offset="0" />
                                <GradientStop Color="{DynamicResource Color.Surface}" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.5" />
                        </Border.Effect>
                        <Grid>
                            <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource Font.Icons}" FontSize="64"
                                       Foreground="{DynamicResource Brush.Accent}" Opacity="0.5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasAlbumArt, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                            <Image Source="{Binding AlbumArt}" Stretch="UniformToFill"
                                   Visibility="{Binding HasAlbumArt, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding Title}" Margin="0,22,0,0"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="340" />

                    <TextBlock Text="{Binding Artist}" Margin="0,4,0,0"
                               FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="340" />

                    <Border Style="{StaticResource BadgeStyle}" Margin="0,10,0,0" HorizontalAlignment="Center"
                            Cursor="Hand" ToolTip="Doble clic para abrir la app"
                            MouseLeftButtonDown="SourceBadge_MouseLeftButtonDown">
                        <TextBlock Text="{Binding SourceApp}" FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                   Foreground="{DynamicResource Brush.Accent}" />
                    </Border>

                    <Grid Margin="0,26,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding PositionText}"
                                   FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                   Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" />

                        <Slider x:Name="ProgressSlider" Grid.Column="1" Margin="10,0"
                                Minimum="0"
                                Style="{StaticResource MinimalSliderStyle}"
                                PreviewMouseLeftButtonDown="ProgressSlider_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="ProgressSlider_PreviewMouseLeftButtonUp" />

                        <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                                   FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                   Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Content="&#xE892;" Style="{StaticResource TransportButtonStyle}" Margin="0,0,14,0"
                                ToolTip="Anterior" Click="Previous_Click" />
                        <Button Content="{Binding IsPlaying, Converter={StaticResource PlayPauseGlyph}}"
                                Style="{StaticResource PlayButtonStyle}" Click="PlayPause_Click" />
                        <Button Content="&#xE893;" Style="{StaticResource TransportButtonStyle}" Margin="14,0,0,0"
                                ToolTip="Siguiente" Click="Next_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Estado vacio: fuera de NowPlayingContent para que no le afecte el fundido -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource Font.Icons}" FontSize="40"
                           Foreground="{DynamicResource Brush.TextDim}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock Text="&gt; nada reproduciendose_" FontFamily="{DynamicResource Font.Mono}" FontSize="14"
                           Foreground="{DynamicResource Brush.TextDim}" HorizontalAlignment="Center" />
                <TextBlock Text="Reproduce algo en Spotify, el navegador u otra app"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                           Foreground="{DynamicResource Brush.TextDim}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- ===================== MEZCLADOR DE VOLUMEN POR APP ===================== -->
        <Border Grid.Column="1" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0"
                Margin="14,0,0,0" Padding="14,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="&gt; VOLUMEN" Margin="0,0,0,4"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                           Foreground="{DynamicResource Brush.TextSecondary}" />

                <TextBlock Grid.Row="1" x:Name="DeviceNameText" Text=""
                           Margin="0,0,0,10"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="9.5"
                           Foreground="{DynamicResource Brush.TextDim}"
                           TextTrimming="CharacterEllipsis" />

                <!-- Volumen maestro -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="&#xE995;"
                                   FontFamily="{DynamicResource Font.Icons}" FontSize="14"
                                   Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" />

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Maestro"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="12" VerticalAlignment="Center" />

                        <ToggleButton Grid.Row="0" Grid.Column="2"
                                      x:Name="MasterMuteToggle"
                                      Style="{StaticResource MuteToggleStyle}"
                                      Click="MasterMuteToggle_Click" />

                        <Slider Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                x:Name="MasterVolumeSlider"
                                Margin="0,8,0,0"
                                Minimum="0" Maximum="1"
                                Style="{StaticResource MinimalSliderStyle}"
                                ValueChanged="MasterVolumeSlider_ValueChanged" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="POR APLICACION" Margin="0,0,0,8"
                                   FontFamily="{DynamicResource Font.Mono}" FontSize="9.5"
                                   Foreground="{DynamicResource Brush.TextDim}" />

                        <ItemsControl x:Name="MixerItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Row="0" Grid.Column="0" Width="22" Height="22" Margin="0,0,8,0">
                                                <Image Source="{Binding Icon}" Stretch="Uniform" />
                                            </Border>

                                            <TextBlock Grid.Row="0" Grid.Column="1"
                                                       Text="{Binding DisplayName}"
                                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <ToggleButton Grid.Row="0" Grid.Column="2"
                                                          Style="{StaticResource MuteToggleStyle}"
                                                          IsChecked="{Binding IsMuted, Mode=TwoWay}" />

                                            <Slider Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                    Margin="0,8,0,0"
                                                    Minimum="0" Maximum="1"
                                                    Style="{StaticResource MinimalSliderStyle}"
                                                    Value="{Binding Volume, Mode=TwoWay}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="MixerEmptyState"
                                   Text="sin apps sonando_"
                                   FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                                   Foreground="{DynamicResource Brush.TextDim}"
                                   HorizontalAlignment="Center" Margin="0,20,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
