<UserControl x:Class="Launcher.Modules.Search.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceActive}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBox x:Name="QueryBox" Grid.Row="0"
                 Style="{StaticResource TextBoxStyle}"
                 Tag="buscar juegos, apps, archivos, comandos, web..."
                 FontSize="15" Padding="14,11"
                 TextChanged="QueryBox_TextChanged"
                 PreviewKeyDown="QueryBox_PreviewKeyDown" />

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <ListBox x:Name="ResultsList"
                     Background="Transparent" BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource ResultItemStyle}"
                     MouseDoubleClick="Results_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                       FontFamily="{DynamicResource Font.Icons}" FontSize="18" Width="30"
                                       Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,10,0">
                                <TextBlock Text="{Binding Title}" FontSize="13"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" Margin="0,2,0,0"
                                           FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                           Foreground="{DynamicResource Brush.TextDim}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource BadgeStyle}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Category}" FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="HintText" Text="&gt; escribe para buscar_"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontFamily="{DynamicResource Font.Mono}" FontSize="14"
                       Foreground="{DynamicResource Brush.TextDim}" />
        </Grid>
    </Grid>
</UserControl>
