<UserControl x:Class="Launcher.Modules.Search.SearchWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceActive}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Barra compacta: los resultados salen en un desplegable, asi no dependen del tamano de la caja -->
        <TextBox x:Name="QueryBox"
                 Style="{StaticResource TextBoxStyle}"
                 Tag="buscar juegos, apps, archivos, web..."
                 VerticalAlignment="Top" FontSize="13" Padding="10,6"
                 ToolTip="Enter: abrir  |  Ctrl+Enter: mostrar en su carpeta  |  Esc: cerrar"
                 TextChanged="QueryBox_TextChanged"
                 PreviewKeyDown="QueryBox_PreviewKeyDown" />

        <Popup x:Name="ResultsPopup"
               PlacementTarget="{Binding ElementName=QueryBox}"
               Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="{Binding ActualWidth, ElementName=QueryBox}"
                    Margin="0,4,0,0" Padding="6" CornerRadius="8"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1">
                <ListBox x:Name="ResultsList"
                         Background="Transparent" BorderThickness="0" MaxHeight="320"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource ResultItemStyle}"
                         PreviewMouseLeftButtonUp="ResultsList_PreviewMouseLeftButtonUp">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                           FontFamily="{DynamicResource Font.Icons}" FontSize="16" Width="26"
                                           Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,10,0">
                                    <TextBlock Text="{Binding Title}" FontSize="12.5"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" Margin="0,2,0,0"
                                               FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                               Foreground="{DynamicResource Brush.TextDim}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Border Grid.Column="2" Style="{StaticResource BadgeStyle}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Category}" FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                               Foreground="{DynamicResource Brush.Accent}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
