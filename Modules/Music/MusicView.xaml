<UserControl x:Class="Launcher.Modules.Music.MusicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Launcher.Core.Converters"
             AllowDrop="True" DragOver="MusicView_DragOver" Drop="MusicView_Drop">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ToolbarBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentDim}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Background}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== TOOLBAR ===================== -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource ToolbarBox}"
                     Tag="buscar cancion..." Margin="0,0,10,0"
                     TextChanged="SearchBox_TextChanged" />

            <ComboBox x:Name="SortCombo" Grid.Column="1" Width="150" Margin="0,0,10,0"
                      SelectedIndex="0" SelectionChanged="SortCombo_SelectionChanged">
                <ComboBoxItem Content="Titulo" />
                <ComboBoxItem Content="Artista" />
                <ComboBoxItem Content="Album" />
                <ComboBoxItem Content="Ano" />
            </ComboBox>

            <Button Grid.Column="2" Content="&#xE8B7;" ToolTip="Cambiar carpeta de la biblioteca"
                    FontFamily="{DynamicResource Font.Icons}"
                    Style="{StaticResource ToolButton}" Width="36"
                    Margin="0,0,10,0" Click="ChangeFolder_Click" />

            <Button Grid.Column="3" Content="Descargar" Style="{StaticResource ToolButton}"
                    Margin="0,0,10,0" Click="Download_Click" />

            <Button Grid.Column="4" Content="+ Importar" Style="{StaticResource ToolButton}" Click="Import_Click" />
        </Grid>

        <!-- Carpeta actual + contador -->
        <TextBlock x:Name="InfoText" Grid.Row="1" Margin="0,0,0,14"
                   FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                   Foreground="{DynamicResource Brush.TextDim}" TextTrimming="CharacterEllipsis" />

        <!-- ===================== GRID DE TARJETAS ===================== -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="TracksItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Width="160" Margin="0,0,14,14"
                                    MouseLeftButtonDown="Card_MouseLeftButtonDown"
                                    Cursor="Hand">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Reproducir" Click="PlayMenuItem_Click" />
                                        <MenuItem Header="Abrir carpeta" Click="OpenFolderMenuItem_Click" />
                                        <Separator />
                                        <MenuItem Header="Autocompletar datos" Click="AutoFillMenuItem_Click" />
                                        <MenuItem Header="Editar" Click="EditMenuItem_Click" />
                                        <Separator />
                                        <MenuItem Header="Eliminar" Click="DeleteMenuItem_Click" />
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <StackPanel>
                                    <!-- Caratula -->
                                    <Grid Height="160">
                                        <Border CornerRadius="8,8,0,0" ClipToBounds="True">
                                            <Grid>
                                                <Border Background="{DynamicResource Brush.SurfaceActive}"
                                                        Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                                    <TextBlock Text="&#xE8D6;"
                                                               FontFamily="{DynamicResource Font.Icons}"
                                                               FontSize="42"
                                                               Foreground="{DynamicResource Brush.TextDim}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                                       Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Titulo + artista/duracion -->
                                    <StackPanel Margin="10,8,10,10">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Margin="0,4,0,0"
                                                   FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                                   Foreground="{DynamicResource Brush.TextDim}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Estado vacio -->
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="&gt; sin canciones_" FontFamily="{DynamicResource Font.Mono}" FontSize="14"
                           Foreground="{DynamicResource Brush.TextDim}" HorizontalAlignment="Center" />
                <TextBlock Text="Arrastra archivos de audio aqui o pulsa Importar"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                           Foreground="{DynamicResource Brush.TextDim}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
