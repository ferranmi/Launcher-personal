<Window x:Class="Launcher.Modules.Music.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Descargar musica"
        Height="680" Width="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Opacity="1" x:Name="Bd">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentDim}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Background}"
            BorderBrush="{DynamicResource Brush.BorderStrong}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.6" />
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="&gt; Descargar musica"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="16"
                           Foreground="{DynamicResource Brush.TextPrimary}" />
                <TextBlock Text="Primero busca y revisa la ficha; no se guarda nada hasta que pulses Guardar."
                           Margin="0,4,0,0"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                           Foreground="{DynamicResource Brush.TextDim}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- ===================== ENTRADA ===================== -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <TextBlock Text="Enlace, o escribe: artista - cancion" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UrlBox" Grid.Column="0" Style="{StaticResource FieldBox}"
                             Margin="0,0,8,0" KeyDown="UrlBox_KeyDown" />
                    <Button x:Name="SearchButton" Grid.Column="1" Content="Buscar"
                            Style="{StaticResource AccentButton}" Click="Search_Click" />
                </Grid>
            </StackPanel>

            <!-- ===================== FICHA DE PREVISUALIZACION ===================== -->
            <Border x:Name="PreviewPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,14" Padding="14"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Caratula -->
                    <StackPanel Grid.Column="0" Margin="0,0,14,0" Width="110">
                        <Border Width="110" Height="110" CornerRadius="6" ClipToBounds="True"
                                Background="{DynamicResource Brush.SurfaceActive}">
                            <Grid>
                                <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource Font.Icons}" FontSize="34"
                                           Foreground="{DynamicResource Brush.TextDim}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="CoverImage" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="CoverText" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                   FontFamily="{DynamicResource Font.Mono}" FontSize="9.5"
                                   Foreground="{DynamicResource Brush.TextDim}" />
                    </StackPanel>

                    <!-- Datos editables -->
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="VerifiedText" Margin="0,0,0,10" TextWrapping="Wrap"
                                   FontFamily="{DynamicResource Font.Mono}" FontSize="10.5" />

                        <TextBlock Text="Titulo" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="TitleBox" Style="{StaticResource FieldBox}" Margin="0,0,0,8" />

                        <TextBlock Text="Artista" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ArtistBox" Style="{StaticResource FieldBox}" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Album" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="AlbumBox" Style="{StaticResource FieldBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Width="80">
                                <TextBlock Text="Ano" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="YearBox" Style="{StaticResource FieldBox}" MaxLength="4" />
                            </StackPanel>
                        </Grid>

                        <!-- Fuente de audio (solo si hay varias versiones) -->
                        <StackPanel x:Name="SourcePanel" Margin="0,0,0,10">
                            <TextBlock Text="Version de audio" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="SourceCombo" SelectionChanged="SourceCombo_SelectionChanged" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ListenButton" Content="Escuchar" Style="{StaticResource GhostButton}"
                                    Margin="0,0,8,0" Click="Listen_Click" />
                            <Button x:Name="SaveButton" Content="Guardar en la biblioteca"
                                    Style="{StaticResource AccentButton}" Click="Save_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Registro de lo que va haciendo el Launcher -->
            <TextBox x:Name="LogBox" Grid.Row="3"
                     Style="{StaticResource FieldBox}"
                     IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                     Foreground="{DynamicResource Brush.TextSecondary}" />

            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="UpdateButton" Grid.Column="0" Content="Actualizar yt-dlp"
                        Style="{StaticResource GhostButton}" Click="UpdateTool_Click" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelRunButton" Content="Cancelar" IsEnabled="False"
                            Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="CancelRun_Click" />
                    <Button Content="Cerrar" Style="{StaticResource GhostButton}" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
