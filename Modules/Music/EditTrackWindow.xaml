<Window x:Class="Launcher.Modules.Music.EditTrackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cancion"
        Height="560" Width="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentDim}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Background}"
            BorderBrush="{DynamicResource Brush.BorderStrong}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.6" />
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,18" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="HeaderText" Text="&gt; Editar cancion"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="16"
                           Foreground="{DynamicResource Brush.TextPrimary}" />
                <TextBlock x:Name="FileText" Margin="0,4,0,0"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                           Foreground="{DynamicResource Brush.TextDim}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Titulo" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="TitleBox" Style="{StaticResource FieldBox}" Margin="0,0,0,14" />

                <TextBlock Text="Artista" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ArtistBox" Style="{StaticResource FieldBox}" Margin="0,0,0,14" />

                <TextBlock Text="Album" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="AlbumBox" Style="{StaticResource FieldBox}" Margin="0,0,0,14" />

                <TextBlock Text="Ano" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="YearBox" Style="{StaticResource FieldBox}" Width="100"
                         HorizontalAlignment="Left" MaxLength="4" Margin="0,0,0,14" />

                <TextBlock Text="Caratula" Style="{StaticResource FieldLabel}" />
                <StackPanel Orientation="Horizontal">
                    <Border Width="110" Height="110" CornerRadius="6" ClipToBounds="True"
                            Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <Grid>
                            <TextBlock x:Name="NoCoverText" Text="sin caratula"
                                       FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                       Foreground="{DynamicResource Brush.TextDim}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="CoverImage" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel VerticalAlignment="Bottom" Margin="14,0,0,0">
                        <Button Content="Elegir imagen..." Style="{StaticResource GhostButton}"
                                Margin="0,0,0,8" Click="ChooseCover_Click" />
                        <Button Content="Quitar caratula" Style="{StaticResource GhostButton}"
                                Click="RemoveCover_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancelar" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="Guardar" Style="{StaticResource AccentButton}" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
