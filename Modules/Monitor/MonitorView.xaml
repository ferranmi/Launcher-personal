<UserControl x:Class="Launcher.Modules.Monitor.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="StatCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>

        <Style x:Key="StatBigNumberStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>

        <!-- Tarjeta estandar reutilizada por CPU, RAM, GPU y VRAM: mismo layout
             (etiqueta + numero grande + sparkline), asi las cuatro se ven identicas. -->
        <Style x:Key="StatCardGridStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="AccentProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="7" />
            <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Rectangle x:Name="PART_Indicator"
                                           Fill="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Left"
                                           RadiusX="4" RadiusY="4" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== HEADER: uptime ===================== -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="SISTEMA" FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                       Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" />
            <TextBlock x:Name="UptimeText" Text="Actividad: --"
                       HorizontalAlignment="Right"
                       FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                       Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" />
        </Grid>

        <!-- ===================== CPU + RAM ===================== -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CPU -->
            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="CPU" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="CpuPercentText" Text="0%" Style="{StaticResource StatBigNumberStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Polyline x:Name="CpuSparkline" Grid.Column="1" Width="160" Height="42"
                              Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.5" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- RAM -->
            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="MEMORIA" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="RamPercentText" Text="0%" Style="{StaticResource StatBigNumberStyle}" Margin="0,4,0,0" />
                        <TextBlock x:Name="RamDetailText" Text="0 GB / 0 GB"
                                   FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                   Foreground="{DynamicResource Brush.TextDim}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Polyline x:Name="RamSparkline" Grid.Column="1" Width="160" Height="42"
                              Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.5" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== GPU + VRAM (mismo layout que CPU/RAM) ===================== -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- GPU -->
            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="GpuLabelText" Text="GPU" Style="{StaticResource StatLabelStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="GpuPercentText" Text="0%" Style="{StaticResource StatBigNumberStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Polyline x:Name="GpuSparkline" Grid.Column="1" Width="160" Height="42"
                              Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.5" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- VRAM -->
            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="VRAM" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="VramPercentText" Text="0%" Style="{StaticResource StatBigNumberStyle}" Margin="0,4,0,0" />
                        <TextBlock x:Name="VramDetailText" Text="0 GB / 0 GB"
                                   FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                   Foreground="{DynamicResource Brush.TextDim}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Polyline x:Name="VramSparkline" Grid.Column="1" Width="160" Height="42"
                              Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.5" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== RED ===================== -->
        <Border Grid.Row="3" Style="{StaticResource StatCardStyle}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,30,0">
                    <TextBlock Text="&#x2193; RED (descarga)" Style="{StaticResource StatLabelStyle}" />
                    <TextBlock x:Name="NetDownText" Text="0 KB/s" FontFamily="{DynamicResource Font.Mono}"
                               FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,30,0">
                    <TextBlock Text="&#x2191; RED (subida)" Style="{StaticResource StatLabelStyle}" />
                    <TextBlock x:Name="NetUpText" Text="0 KB/s" FontFamily="{DynamicResource Font.Mono}"
                               FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,4,0,0" />
                </StackPanel>
                <Polyline x:Name="NetSparkline" Grid.Column="2" Height="40"
                          Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.4"
                          VerticalAlignment="Center" HorizontalAlignment="Stretch" />
            </Grid>
        </Border>

        <!-- ===================== ALMACENAMIENTO ===================== -->
        <Border Grid.Row="4" Style="{StaticResource StatCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ALMACENAMIENTO" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,12" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DrivesItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}"
                                               FontFamily="{DynamicResource Font.Mono}" FontSize="13"
                                               Foreground="{DynamicResource Brush.TextPrimary}" />

                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                                               Foreground="{DynamicResource Brush.TextDim}">
                                        <Run Text="{Binding UsedGB, StringFormat={}{0:0.#}}" />
                                        <Run Text=" GB / " />
                                        <Run Text="{Binding TotalGB, StringFormat={}{0:0.#}}" />
                                        <Run Text=" GB" />
                                    </TextBlock>

                                    <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                 Style="{StaticResource AccentProgressBar}"
                                                 Minimum="0" Maximum="100"
                                                 Value="{Binding UsedPercent, Mode=OneWay}"
                                                 Margin="0,6,0,0" />

                                    <!-- Velocidad de lectura/escritura de esta unidad, justo debajo de su barra -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                                Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                                   Foreground="{DynamicResource Brush.TextDim}">
                                            <Run Text="&#x2193; " />
                                            <Run Text="{Binding ReadDisplay}" />
                                        </TextBlock>
                                        <TextBlock FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                                   Foreground="{DynamicResource Brush.TextDim}" Margin="14,0,0,0">
                                            <Run Text="&#x2191; " />
                                            <Run Text="{Binding WriteDisplay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>