<Window x:Class="Launcher.Modules.Commands.AddEditCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comando"
        Height="720" Width="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentDim}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        </Style>

        <!-- Cada glifo es un ToggleButton cuadrado; el seleccionado se resalta con el acento. -->
        <Style x:Key="IconOptionStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Icons}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentDim}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Background}"
            BorderBrush="{DynamicResource Brush.BorderStrong}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.6" />
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="HeaderText" Grid.Row="0" Text="&gt; Anadir comando"
                       FontFamily="{DynamicResource Font.Mono}" FontSize="16"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       Margin="0,0,0,18" MouseLeftButtonDown="Header_MouseLeftButtonDown" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}" Margin="0,0,0,14" />

                    <TextBlock Text="Categoria" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="CategoryCombo" Margin="0,0,0,14" SelectedIndex="0">
                        <ComboBoxItem Content="Aplicacion" />
                        <ComboBoxItem Content="Periferico" />
                        <ComboBoxItem Content="Sistema" />
                        <ComboBoxItem Content="CLI" />
                    </ComboBox>

                    <TextBlock Text="Comando o ruta del ejecutable" Style="{StaticResource FieldLabel}" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TargetBox" Grid.Column="0" Style="{StaticResource FieldBox}" Margin="0,0,8,0"
                                 TextChanged="TargetBox_TextChanged" />
                        <Button Grid.Column="1" Content="..." Style="{StaticResource GhostButton}" Width="34" Click="BrowseTarget_Click" />
                    </Grid>
                    <TextBlock Text="Puede ser una ruta (C:\...\app.exe) o un comando en el PATH (p.ej. kunai)"
                               FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                               Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,14" TextWrapping="Wrap" />

                    <TextBlock Text="Argumentos (opcional)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ArgumentsBox" Style="{StaticResource FieldBox}" Margin="0,0,0,14" />

                    <!-- Solo aparece si el destino es un navegador conocido. -->
                    <StackPanel x:Name="IncognitoPanel" Visibility="Collapsed" Margin="0,0,0,14">
                        <CheckBox x:Name="IncognitoCheck" Content="Abrir en ventana privada (incognito)"
                                  Foreground="{DynamicResource Brush.TextSecondary}"
                                  FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                                  Click="IncognitoCheck_Click" />
                        <TextBlock x:Name="IncognitoHint" Text=""
                                   FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                   Foreground="{DynamicResource Brush.TextDim}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Text="Carpeta de trabajo (opcional)" Style="{StaticResource FieldLabel}" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WorkingDirBox" Grid.Column="0" Style="{StaticResource FieldBox}" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="..." Style="{StaticResource GhostButton}" Width="34" Click="BrowseWorkingDir_Click" />
                    </Grid>

                    <!-- ===================== ICONO ===================== -->
                    <TextBlock Text="Icono" Style="{StaticResource FieldLabel}" />
                    <WrapPanel x:Name="IconPanel" Orientation="Horizontal" Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border x:Name="IconPreviewBorder" Width="34" Height="34" CornerRadius="6"
                                Background="{DynamicResource Brush.AccentDim}" Margin="0,0,10,0"
                                Visibility="Collapsed">
                            <Image x:Name="IconPreview" Width="22" Height="22" Stretch="Uniform" />
                        </Border>
                        <Button Content="Icono de la app" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                ToolTip="Extrae el icono del ejecutable indicado arriba"
                                Click="UseAppIcon_Click" />
                        <Button Content="Elegir imagen..." Style="{StaticResource GhostButton}"
                                ToolTip=".ico, .png o .jpg (p.ej. los .ico que ya tengas)"
                                Click="BrowseIconImage_Click" />
                    </StackPanel>
                    <TextBlock x:Name="IconStatus" Text=""
                               FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                               Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,14" TextWrapping="Wrap" />

                    <TextBlock Text="Ejecutar dentro de" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="TerminalCombo" Margin="0,0,0,10" SelectedIndex="0">
                        <ComboBoxItem Content="Ninguna (lanzamiento directo)" />
                        <ComboBoxItem Content="CMD" />
                        <ComboBoxItem Content="PowerShell" />
                    </ComboBox>
                    <TextBlock Text="Necesario para herramientas CLI/TUI. Kunai, por ejemplo, va por PowerShell."
                               FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                               Foreground="{DynamicResource Brush.TextDim}" Margin="0,-6,0,14" TextWrapping="Wrap" />

                    <CheckBox x:Name="RunAsAdminCheck" Content="Ejecutar como administrador"
                              Foreground="{DynamicResource Brush.TextSecondary}"
                              FontFamily="{DynamicResource Font.Mono}" FontSize="11" />
                    <TextBlock Text="Mostrara el dialogo de UAC de Windows cada vez que se ejecute."
                               FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                               Foreground="{DynamicResource Brush.TextDim}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancelar" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="Guardar" Style="{StaticResource AccentButton}" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
