<UserControl x:Class="Launcher.Modules.ImageGen.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Launcher.Modules.ImageGen"
             xmlns:conv="clr-namespace:Launcher.Core.Converters">

    <UserControl.Resources>
        <local:ThumbnailConverter x:Key="Thumb" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="CardItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" BorderThickness="2"
                                BorderBrush="{DynamicResource Brush.Border}" ClipToBounds="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Background}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- ===================== CABECERA ===================== -->
            <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="&#xE72B;  Volver" Padding="12,6"
                        Style="{StaticResource SecondaryButtonStyle}" Click="Back_Click" />
                <TextBlock Grid.Column="1" Text="&gt; biblioteca_" Margin="16,0,0,0" VerticalAlignment="Center"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="14"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <TextBlock x:Name="CountText" Grid.Column="2" VerticalAlignment="Center"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                           Foreground="{DynamicResource Brush.TextDim}" />
            </Grid>

            <!-- ===================== FILTROS ===================== -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource TextBoxStyle}"
                         Tag="buscar en prompts, negativos, modelo..." Padding="10,7" Margin="0,0,10,0"
                         TextChanged="SearchBox_TextChanged" />
                <ComboBox x:Name="ModelFilter" Grid.Column="1" Margin="0,0,10,0"
                          ToolTip="Filtrar por modelo" SelectionChanged="Filter_Changed" />
                <ComboBox x:Name="SamplerFilter" Grid.Column="2" Margin="0,0,10,0"
                          ToolTip="Filtrar por sampler" SelectionChanged="Filter_Changed" />
                <CheckBox x:Name="FavOnly" Grid.Column="3" Content="Solo favoritas" Margin="0,0,10,0"
                          VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"
                          Checked="Filter_Changed" Unchecked="Filter_Changed" />
                <ComboBox x:Name="SortCombo" Grid.Column="4" SelectedIndex="0" SelectionChanged="Sort_Changed">
                    <ComboBoxItem Content="Mas recientes" />
                    <ComboBoxItem Content="Mas antiguas" />
                </ComboBox>
            </Grid>

            <!-- ===================== REJILLA ===================== -->
            <Grid Grid.Row="2" Grid.Column="0">
                <ListBox x:Name="ImagesList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource CardItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ImagesList_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="150" Height="150" ToolTip="{Binding Summary}">
                                <Image Source="{Binding FilePath, Converter={StaticResource Thumb}, ConverterParameter=300}"
                                       Stretch="UniformToFill" />
                                <Border Background="#AA000000" CornerRadius="4" Width="22" Height="22"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5"
                                        Visibility="{Binding Favorite, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="&#xE734;" FontFamily="{DynamicResource Font.Icons}" FontSize="11"
                                               Foreground="{DynamicResource Brush.Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyText" Text="&gt; sin resultados_" Visibility="Collapsed"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="14"
                           Foreground="{DynamicResource Brush.TextDim}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- ===================== DETALLE ===================== -->
            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="16,0,0,0" Padding="12">
                <Grid>
                    <TextBlock x:Name="DetailEmpty" Text="&gt; elige una imagen_"
                               FontFamily="{DynamicResource Font.Mono}" FontSize="12"
                               Foreground="{DynamicResource Brush.TextDim}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <ScrollViewer x:Name="DetailScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                            <Image x:Name="DetailImage" MaxHeight="280" Stretch="Uniform" Margin="0,0,0,12" />

                            <TextBlock Text="PROMPT" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="DetailPrompt" Style="{StaticResource TextBoxStyle}" IsReadOnly="True"
                                     TextWrapping="Wrap" MaxHeight="150" VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" />

                            <TextBlock Text="NEGATIVO" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="DetailNegative" Style="{StaticResource TextBoxStyle}" IsReadOnly="True"
                                     TextWrapping="Wrap" MaxHeight="100" VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                            <TextBlock x:Name="DetailMeta" TextWrapping="Wrap" Margin="0,0,0,14"
                                       FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />

                            <WrapPanel>
                                <Button Content="Reutilizar" Padding="12,6" Margin="0,0,6,6"
                                        Style="{StaticResource PrimaryButtonStyle}" Click="Reuse_Click" />
                                <Button Content="Copiar prompt" Padding="10,6" Margin="0,0,6,6"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="CopyPrompt_Click" />
                                <Button x:Name="FavButton" Content="Favorita" Padding="10,6" Margin="0,0,6,6"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="Favorite_Click" />
                                <Button Content="Carpeta" Padding="10,6" Margin="0,0,6,6"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="OpenFolder_Click" />
                                <Button Content="Eliminar" Padding="10,6" Margin="0,0,6,6"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="Delete_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
