<UserControl x:Class="Launcher.Modules.ImageGen.ImageGenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Launcher.Modules.ImageGen">

    <UserControl.Resources>
        <local:ThumbnailConverter x:Key="Thumb" />

        <!-- Slider minimalista (mismo que el mezclador de Multimedia) -->
        <Style x:Key="MinimalSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="16" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource Brush.Accent}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource Brush.Border}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource Brush.Accent}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Rectangle x:Name="PART_Indicator" Fill="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Left" RadiusX="3" RadiusY="3" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fila de la lista de LoRAs -->
        <Style x:Key="ListRowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceActive}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Contenedor de miniatura de la galeria -->
        <Style x:Key="ThumbItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" BorderThickness="2"
                                BorderBrush="{DynamicResource Brush.Border}" ClipToBounds="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Biblioteca: se superpone a todo el modulo -->
        <local:LibraryView x:Name="Library" Grid.ColumnSpan="2" Panel.ZIndex="10" Visibility="Collapsed" />

        <!-- ===================== PANEL DE PARAMETROS ===================== -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
            <StackPanel Margin="0,0,10,0">

                <TextBlock Text="&gt; imagenes_" FontFamily="{DynamicResource Font.Mono}" FontSize="14"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,8" />

                <TextBlock x:Name="ServerStatusText" Text="sin conectar"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                           Foreground="{DynamicResource Brush.TextDim}" TextWrapping="Wrap" Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button x:Name="ConnectButton" Content="Conectar" Padding="12,6" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}" Click="Connect_Click" />
                    <Button x:Name="StartServerButton" Content="Iniciar servidor" Padding="12,6"
                            Style="{StaticResource SecondaryButtonStyle}" Click="StartServer_Click" />
                </StackPanel>

                <Button Content="Biblioteca de generaciones" Margin="0,-6,0,16" Padding="12,6"
                        Style="{StaticResource SecondaryButtonStyle}" Click="Library_Click" />

                <!-- Modelo -->
                <TextBlock Text="MODELO (checkpoint)" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox x:Name="ModelCombo" DisplayMemberPath="Name" Margin="0,0,0,14" />

                <!-- Prompts -->
                <TextBlock Text="PROMPT" Style="{StaticResource FieldLabelStyle}" />
                <TextBox x:Name="PromptBox" Style="{StaticResource TextBoxStyle}" Tag="describe la imagen..."
                         Height="110" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" />

                <TextBlock Text="PROMPT NEGATIVO" Style="{StaticResource FieldLabelStyle}" />
                <TextBox x:Name="NegativeBox" Style="{StaticResource TextBoxStyle}" Tag="lo que no quieres ver..."
                         Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14" />

                <!-- Sampler / scheduler -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SAMPLER" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="SamplerCombo" />
                    </StackPanel>
                    <StackPanel x:Name="SchedulerPanel" Grid.Column="2">
                        <TextBlock Text="SCHEDULER" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="SchedulerCombo" />
                    </StackPanel>
                </Grid>

                <!-- Steps -->
                <Grid>
                    <TextBlock Text="STEPS" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Style="{StaticResource ValueText}"
                               Text="{Binding Value, ElementName=StepsSlider, StringFormat={}{0:0}}" />
                </Grid>
                <Slider x:Name="StepsSlider" Minimum="1" Maximum="150" Value="20"
                        IsSnapToTickEnabled="True" TickFrequency="1"
                        Style="{StaticResource MinimalSliderStyle}" Margin="0,0,0,12" />

                <!-- CFG -->
                <Grid>
                    <TextBlock Text="CFG SCALE" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Style="{StaticResource ValueText}"
                               Text="{Binding Value, ElementName=CfgSlider, StringFormat={}{0:0.0}}" />
                </Grid>
                <Slider x:Name="CfgSlider" Minimum="1" Maximum="30" Value="7"
                        IsSnapToTickEnabled="True" TickFrequency="0.5"
                        Style="{StaticResource MinimalSliderStyle}" Margin="0,0,0,12" />

                <!-- Tamano -->
                <Grid>
                    <TextBlock Text="ANCHO" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Style="{StaticResource ValueText}"
                               Text="{Binding Value, ElementName=WidthSlider, StringFormat={}{0:0}}" />
                </Grid>
                <Slider x:Name="WidthSlider" Minimum="64" Maximum="2048" Value="512"
                        IsSnapToTickEnabled="True" TickFrequency="64"
                        Style="{StaticResource MinimalSliderStyle}" Margin="0,0,0,12" />

                <Grid>
                    <TextBlock Text="ALTO" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Style="{StaticResource ValueText}"
                               Text="{Binding Value, ElementName=HeightSlider, StringFormat={}{0:0}}" />
                </Grid>
                <Slider x:Name="HeightSlider" Minimum="64" Maximum="2048" Value="512"
                        IsSnapToTickEnabled="True" TickFrequency="64"
                        Style="{StaticResource MinimalSliderStyle}" Margin="0,0,0,14" />

                <!-- Seed / batch -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SEED (-1 = aleatoria)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="SeedBox" Style="{StaticResource TextBoxStyle}" Text="-1" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="TANDAS" Style="{StaticResource FieldLabelStyle}"
                                   ToolTip="Batch count: cuantas tandas seguidas" />
                        <TextBox x:Name="BatchCountBox" Style="{StaticResource TextBoxStyle}" Text="1" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="POR TANDA" Style="{StaticResource FieldLabelStyle}"
                                   ToolTip="Batch size: imagenes en paralelo (mas VRAM)" />
                        <TextBox x:Name="BatchSizeBox" Style="{StaticResource TextBoxStyle}" Text="1" Padding="8,6" />
                    </StackPanel>
                </Grid>

                <!-- Clip skip / VAE -->
                <Grid>
                    <TextBlock Text="CLIP SKIP" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Style="{StaticResource ValueText}"
                               Text="{Binding Value, ElementName=ClipSkipSlider, StringFormat={}{0:0}}" />
                </Grid>
                <Slider x:Name="ClipSkipSlider" Minimum="1" Maximum="12" Value="1"
                        IsSnapToTickEnabled="True" TickFrequency="1"
                        Style="{StaticResource MinimalSliderStyle}" Margin="0,0,0,12" />

                <TextBlock Text="VAE" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox x:Name="VaeCombo" Margin="0,0,0,16" />

                <!-- LoRA / LyCORIS -->
                <Grid>
                    <TextBlock Text="LORA / LYCORIS" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="LoraCountText" Style="{StaticResource ValueText}" Text="" />
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LoraFilterBox" Grid.Column="0" Style="{StaticResource TextBoxStyle}"
                             Tag="filtrar..." Padding="8,6" Margin="0,0,8,0"
                             TextChanged="LoraFilterBox_TextChanged" />
                    <Button Grid.Column="1" Content="&#xE72C;" ToolTip="Reescanear la carpeta de LoRAs"
                            FontFamily="{DynamicResource Font.Icons}" Padding="10,6"
                            Style="{StaticResource SecondaryButtonStyle}" Click="RefreshLoras_Click" />
                </Grid>

                <ListBox x:Name="LoraList" Height="150"
                         Background="{DynamicResource Brush.Surface}"
                         BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                         ItemContainerStyle="{StaticResource ListRowStyle}"
                         MouseDoubleClick="LoraList_MouseDoubleClick" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="peso" VerticalAlignment="Center" Margin="0,0,8,0"
                               FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                               Foreground="{DynamicResource Brush.TextDim}" />
                    <TextBox x:Name="LoraWeightBox" Grid.Column="1" Style="{StaticResource TextBoxStyle}"
                             Text="0.8" Padding="8,6" />
                    <TextBlock Grid.Column="2" Text="doble clic: insertar en el prompt" Margin="10,0,0,0"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               FontFamily="{DynamicResource Font.Mono}" FontSize="9.5"
                               Foreground="{DynamicResource Brush.TextDim}" />
                </Grid>

                <TextBlock Margin="0,6,0,20" TextWrapping="Wrap"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="9.5"
                           Foreground="{DynamicResource Brush.TextDim}"
                           Text="Inserta &lt;lora:nombre:peso&gt;. Los LyCORIS usan la misma sintaxis y aparecen en esta lista (A1111 1.5+)." />

                <!-- Extensiones (se rellena desde codigo con SdExtensionCatalog) -->
                <TextBlock Text="EXTENSIONES" Style="{StaticResource FieldLabelStyle}" Margin="2,4,0,6" />
                <StackPanel x:Name="ExtensionsHost" Margin="0,0,0,24" />
            </StackPanel>
        </ScrollViewer>

        <!-- ===================== PREVIEW + GALERIA ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="112" />
            </Grid.RowDefinitions>

            <!-- Preview -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="8" ClipToBounds="True">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="Uniform" />
                    <TextBlock x:Name="PreviewEmpty" Text="&gt; sin imagenes_"
                               FontFamily="{DynamicResource Font.Mono}" FontSize="14"
                               Foreground="{DynamicResource Brush.TextDim}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Progreso + botones -->
            <Grid Grid.Row="1" Margin="0,12,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ProgressBar x:Name="GenProgress" Style="{StaticResource AccentProgressBar}"
                                 Minimum="0" Maximum="100" Value="0" />
                    <TextBlock x:Name="ProgressText" Text="" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                               FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                               Foreground="{DynamicResource Brush.TextDim}" />
                </StackPanel>

                <Button x:Name="CancelButton" Grid.Column="1" Content="Cancelar" Margin="14,0,8,0"
                        Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" Click="Cancel_Click" />
                <Button x:Name="GenerateButton" Grid.Column="2" Content="Generar"
                        Style="{StaticResource PrimaryButtonStyle}" Click="Generate_Click" />
            </Grid>

            <!-- Galeria -->
            <ListBox x:Name="GalleryList" Grid.Row="2"
                     Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource ThumbItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     SelectionChanged="GalleryList_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="92" Height="92" ToolTip="{Binding Summary}">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Reutilizar parametros" Click="ReuseMenuItem_Click" />
                                    <MenuItem Header="Mostrar en carpeta" Click="OpenFolderMenuItem_Click" />
                                    <Separator />
                                    <MenuItem Header="Eliminar" Click="DeleteMenuItem_Click" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Image Source="{Binding FilePath, Converter={StaticResource Thumb}, ConverterParameter=200}"
                                   Stretch="UniformToFill" />
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
