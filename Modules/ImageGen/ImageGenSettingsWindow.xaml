<Window x:Class="Launcher.Modules.ImageGen.ImageGenSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Imagenes IA"
        Height="680" Width="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentDim}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Background}"
            BorderBrush="{DynamicResource Brush.BorderStrong}"
            BorderThickness="1" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.6" />
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="&gt; Imagenes IA: instalacion"
                       FontFamily="{DynamicResource Font.Mono}" FontSize="16"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       MouseLeftButtonDown="Header_MouseLeftButtonDown" />

            <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">

                    <!-- Servidor -->
                    <TextBlock Text="Direccion del servidor" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="UrlBox" Style="{StaticResource FieldBox}" Margin="0,0,0,16" />

                    <!-- Instalacion -->
                    <TextBlock Text="Carpeta de instalacion de A1111 (donde esta webui-user.bat)" Style="{StaticResource FieldLabel}" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InstallBox" Grid.Column="0" Style="{StaticResource FieldBox}" Margin="0,0,8,0"
                                 LostFocus="InstallBox_LostFocus" />
                        <Button Grid.Column="1" Content="..." Style="{StaticResource GhostButton}" Width="34"
                                Click="BrowseInstall_Click" />
                    </Grid>

                    <WrapPanel Margin="0,0,0,10">
                        <Button x:Name="AutoDetectButton" Content="Auto-detectar" Style="{StaticResource GhostButton}"
                                Margin="0,0,8,0" Click="AutoDetect_Click"
                                ToolTip="Usa el servidor si esta en marcha o busca en las rutas habituales" />
                        <Button Content="Comprobar" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Click="Check_Click" />
                        <Button Content="Anadir --api" Style="{StaticResource GhostButton}"
                                Click="AddApi_Click"
                                ToolTip="Anade --api a COMMANDLINE_ARGS en webui-user.bat (guarda una copia .bak)" />
                    </WrapPanel>

                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                        <TextBlock x:Name="StatusText" Style="{StaticResource HintText}"
                                   Foreground="{DynamicResource Brush.TextSecondary}" FontSize="10.5" />
                    </Border>

                    <CheckBox x:Name="AutoStartCheck" Content="Iniciar A1111 automaticamente al abrir el modulo (si esta apagado)"
                              Foreground="{DynamicResource Brush.TextSecondary}"
                              FontFamily="{DynamicResource Font.Mono}" FontSize="11" Margin="0,0,0,18" />

                    <!-- Carpetas (filas generadas desde codigo) -->
                    <TextBlock Text="Carpetas" Style="{StaticResource FieldLabel}" FontSize="12" Margin="0,0,0,2" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,10"
                               Text="Vacio = la de la instalacion (o la que informa A1111 si lo lanzaste con --lora-dir, --ckpt-dir...). Escribe o elige una ruta para usar otra." />
                    <StackPanel x:Name="FolderRows" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,18"
                               Text="Imagenes del Launcher: donde se guardan las nuevas. Las ya generadas se quedan donde estaban." />

                    <!-- Wildcards -->
                    <TextBlock Text="Carpeta de wildcards" Style="{StaticResource FieldLabel}" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WildcardsBox" Grid.Column="0" Style="{StaticResource FieldBox}" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="..." Style="{StaticResource GhostButton}" Width="34"
                                Click="BrowseWildcards_Click" />
                    </Grid>
                    <WrapPanel Margin="0,0,0,6">
                        <Button Content="Usar la de Dynamic Prompts" Style="{StaticResource GhostButton}"
                                Margin="0,0,8,0" Click="UseDynamicPrompts_Click" />
                        <Button Content="Predeterminada" Style="{StaticResource GhostButton}" Click="DefaultWildcards_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="WildcardsHint" Style="{StaticResource HintText}" Margin="0,0,0,10" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancelar" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="Guardar" Style="{StaticResource AccentButton}" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
