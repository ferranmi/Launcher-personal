<UserControl x:Class="Launcher.Modules.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="Margin" Value="2,18,0,8" />
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>

        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <!-- Fila de ajuste: Header = titulo, Tag = descripcion, Content = control de la derecha -->
        <Style x:Key="SettingRow" TargetType="HeaderedContentControl">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <Border Style="{StaticResource CardStyle}" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Interruptor on/off -->
        <Style x:Key="SwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="11"
                                Background="{DynamicResource Brush.SurfaceActive}"
                                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1">
                            <Ellipse x:Name="Knob" Width="14" Height="14"
                                     Fill="{DynamicResource Brush.TextSecondary}"
                                     HorizontalAlignment="Left" Margin="3,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.AccentDim}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentDim}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Background}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="&gt; Configuracion" Style="{StaticResource MonoHeadingStyle}" />

            <!-- ===================== ARRANQUE ===================== -->
            <TextBlock Text="ARRANQUE" Style="{StaticResource SectionTitle}" />

            <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Iniciar con Windows"
                                    Tag="Abre el launcher automaticamente al iniciar sesion.">
                <ToggleButton x:Name="StartWithWindowsToggle" Style="{StaticResource SwitchStyle}"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Iniciar minimizado"
                                    Tag="Solo en el arranque automatico. Con 'Cerrar a la bandeja' activo, arranca directamente en la bandeja.">
                <ToggleButton x:Name="StartMinimizedToggle" Style="{StaticResource SwitchStyle}"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Modulo inicial"
                                    Tag="Que pantalla se abre al arrancar el launcher.">
                <WrapPanel x:Name="StartModulePanel" MaxWidth="330" HorizontalAlignment="Right" />
            </HeaderedContentControl>

            <!-- ===================== VENTANA ===================== -->
            <TextBlock Text="VENTANA" Style="{StaticResource SectionTitle}" />

            <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Color de acento"
                                    Tag="Color de botones, seleccion y detalles. Se aplica al instante.">
                <WrapPanel x:Name="AccentPanel" MaxWidth="330" HorizontalAlignment="Right" />
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Siempre encima"
                                    Tag="Mantiene el launcher por encima del resto de ventanas.">
                <ToggleButton x:Name="AlwaysOnTopToggle" Style="{StaticResource SwitchStyle}"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Cerrar a la bandeja"
                                    Tag="La X oculta la ventana y deja un icono junto al reloj. Para salir del todo: clic derecho en el icono, Salir.">
                <ToggleButton x:Name="CloseToTrayToggle" Style="{StaticResource SwitchStyle}"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Recordar tamano y posicion"
                                    Tag="Al abrir, la ventana vuelve a donde la dejaste.">
                <ToggleButton x:Name="RememberBoundsToggle" Style="{StaticResource SwitchStyle}"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Atajo global"
                                    Tag="Muestra u oculta el launcher desde cualquier sitio. Alt+Espacio queda libre para el futuro asistente.">
                <WrapPanel x:Name="HotkeyPanel" MaxWidth="330" HorizontalAlignment="Right">
                    <RadioButton Content="Ninguno" Tag="None" GroupName="Hotkey" Style="{StaticResource ChipStyle}" Checked="Chip_Checked" />
                    <RadioButton Content="Ctrl+Alt+L" Tag="Ctrl+Alt+L" GroupName="Hotkey" Style="{StaticResource ChipStyle}" Checked="Chip_Checked" />
                    <RadioButton Content="Ctrl+Alt+Espacio" Tag="Ctrl+Alt+Space" GroupName="Hotkey" Style="{StaticResource ChipStyle}" Checked="Chip_Checked" />
                    <RadioButton Content="Ctrl+Shift+Espacio" Tag="Ctrl+Shift+Space" GroupName="Hotkey" Style="{StaticResource ChipStyle}" Checked="Chip_Checked" />
                </WrapPanel>
            </HeaderedContentControl>

            <!-- ===================== MONITOR Y PROCESOS ===================== -->
            <TextBlock Text="MONITOR Y PROCESOS" Style="{StaticResource SectionTitle}" />

            <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Intervalo de refresco"
                                    Tag="Cada cuanto se actualizan Monitor y Procesos. Auto usa 1 s en Monitor y 1,5 s en Procesos. Mas segundos = menos consumo.">
                <StackPanel x:Name="RefreshPanel" Orientation="Horizontal">
                    <RadioButton Content="Auto" Tag="0" GroupName="Refresh" Style="{StaticResource ChipStyle}" Checked="Chip_Checked" />
                    <RadioButton Content="1 s" Tag="1" GroupName="Refresh" Style="{StaticResource ChipStyle}" Checked="Chip_Checked" />
                    <RadioButton Content="3 s" Tag="3" GroupName="Refresh" Style="{StaticResource ChipStyle}" Checked="Chip_Checked" />
                    <RadioButton Content="5 s" Tag="5" GroupName="Refresh" Style="{StaticResource ChipStyle}" Checked="Chip_Checked" />
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Confirmar al finalizar procesos"
                                    Tag="Pregunta antes de cerrar un proceso o un grupo. Los cambios sin guardar de esos procesos se pierden.">
                <ToggleButton x:Name="ConfirmKillToggle" Style="{StaticResource SwitchStyle}"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
            </HeaderedContentControl>

            <!-- ===================== JUEGOS ===================== -->
            <TextBlock Text="JUEGOS" Style="{StaticResource SectionTitle}" />

            <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Tamano de las tarjetas"
                                    Tag="Se aplica al instante en la vista de Juegos.">
                <StackPanel x:Name="CardSizePanel" Orientation="Horizontal">
                    <RadioButton Content="Pequeno" Tag="small" GroupName="CardSize" Style="{StaticResource ChipStyle}" Checked="Chip_Checked" />
                    <RadioButton Content="Mediano" Tag="medium" GroupName="CardSize" Style="{StaticResource ChipStyle}" Checked="Chip_Checked" />
                    <RadioButton Content="Grande" Tag="large" GroupName="CardSize" Style="{StaticResource ChipStyle}" Checked="Chip_Checked" />
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Sincronizar al abrir"
                                    Tag="Busca juegos nuevos de Steam/Epic la primera vez que abres Juegos en cada sesion.">
                <ToggleButton x:Name="SyncOnStartupToggle" Style="{StaticResource SwitchStyle}"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Confirmar al eliminar un juego"
                                    Tag="Pregunta antes de quitar un juego del launcher (nunca borra los archivos del juego).">
                <ToggleButton x:Name="ConfirmDeleteToggle" Style="{StaticResource SwitchStyle}"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
            </HeaderedContentControl>

            <HeaderedContentControl x:Name="IgnoredRow" Style="{StaticResource SettingRow}"
                                    Header="Juegos eliminados de Steam/Epic">
                <Button Content="Restaurar" Style="{StaticResource ActionButton}" Click="RestoreIgnored_Click" />
            </HeaderedContentControl>

            <HeaderedContentControl x:Name="SyncFoldersRow" Style="{StaticResource SettingRow}"
                                    Header="Carpetas de sincronizacion">
                <Button Content="Configurar" Style="{StaticResource ActionButton}" Click="ConfigureFolders_Click" />
            </HeaderedContentControl>

            <HeaderedContentControl x:Name="SteamAccountRow" Style="{StaticResource SettingRow}"
                                    Header="Cuenta de Steam (logros)">
                <Button Content="Configurar" Style="{StaticResource ActionButton}" Click="ConfigureSteamAccount_Click" />
            </HeaderedContentControl>

            <HeaderedContentControl x:Name="CoversRow" Style="{StaticResource SettingRow}"
                                    Header="Portadas">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Abrir carpeta" Style="{StaticResource ActionButton}" Margin="0,0,8,0"
                            Click="OpenCoversFolder_Click" />
                    <Button x:Name="RepairCoversButton" Content="Reparar faltantes" Style="{StaticResource ActionButton}"
                            Click="RepairCovers_Click" />
                </StackPanel>
            </HeaderedContentControl>

                        <TextBlock Text="ACTUALIZACIONES" Style="{StaticResource SectionTitle}" />

            <HeaderedContentControl x:Name="UpdateRow" Style="{StaticResource SettingRow}" Header="Version">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ApplyUpdateButton" Content="Actualizar" Style="{StaticResource ActionButton}"
                            Margin="0,0,8,0" Visibility="Collapsed" Click="ApplyUpdate_Click" />
                    <Button x:Name="CheckUpdateButton" Content="Buscar ahora" Style="{StaticResource ActionButton}"
                            Click="CheckUpdate_Click" />
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Buscar al abrir"
                                    Tag="Comprueba si hay una version nueva al arrancar y cada 6 horas.">
                <ToggleButton x:Name="CheckUpdatesToggle" Style="{StaticResource SwitchStyle}"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Actualizar automaticamente"
                                    Tag="Si hay una version nueva, la instala sola y reinicia el launcher. Si lo desactivas, solo te avisa en la barra lateral.">
                <ToggleButton x:Name="AutoApplyUpdatesToggle" Style="{StaticResource SwitchStyle}"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
            </HeaderedContentControl>

            <HeaderedContentControl x:Name="UpdateSourceRow" Style="{StaticResource SettingRow}"
                                    Header="Carpeta de versiones">
                <Button Content="Cambiar" Style="{StaticResource ActionButton}" Click="ChangeUpdateSource_Click" />
            </HeaderedContentControl>
            
            <!-- ===================== DATOS ===================== -->
            <TextBlock Text="DATOS" Style="{StaticResource SectionTitle}" />

            <HeaderedContentControl x:Name="DataRow" Style="{StaticResource SettingRow}"
                                    Header="Carpeta de datos">
                <Button Content="Abrir" Style="{StaticResource ActionButton}" Click="OpenDataFolder_Click" />
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Registro de errores"
                                    Tag="Si la app falla, el detalle se guarda aqui. Se conservan 7 dias.">
                <Button Content="Abrir" Style="{StaticResource ActionButton}" Click="OpenLogs_Click" />
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Restablecer ajustes"
                                    Tag="Vuelve a los valores por defecto y quita el arranque con Windows. No toca tus juegos, carpetas ni comandos.">
                <Button Content="Restablecer" Style="{StaticResource ActionButton}" Click="Reset_Click" />
            </HeaderedContentControl>

            <!-- ===================== ACERCA DE ===================== -->
            <TextBlock Text="ACERCA DE" Style="{StaticResource SectionTitle}" />

            <HeaderedContentControl x:Name="AboutRow" Style="{StaticResource SettingRow}"
                                    Header="Launcher" Margin="0,0,0,20" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
