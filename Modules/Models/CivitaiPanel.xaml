<UserControl x:Class="Launcher.Modules.Models.CivitaiPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Launcher.Core.Converters"
             xmlns:local="clr-namespace:Launcher.Modules.Models">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:UrlImageConverter x:Key="UrlImage" />

        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>

        <!-- Etiquetas y casillas del panel de filtros -->
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

        <Style x:Key="FilterCheck" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Margin" Value="0,0,14,6" />
        </Style>

        <Style x:Key="PlainList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Sel" BorderThickness="1" CornerRadius="9" BorderBrush="Transparent"
                                Margin="0,0,10,10" Cursor="Hand">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sel" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Sel" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Cursor="Hand">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceActive}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- ===================== IZQUIERDA ===================== -->
        <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Modos -->
            <StackPanel x:Name="ModesPanel" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton Content="Buscar modelos" Tag="search" GroupName="CvMode" IsChecked="True"
                             Style="{StaticResource ChipStyle}" Checked="Mode_Checked" />
                <RadioButton Content="Colecciones" Tag="collections" GroupName="CvMode"
                             Style="{StaticResource ChipStyle}" Checked="Mode_Checked" />
                <RadioButton Content="Pegar enlaces" Tag="links" GroupName="CvMode"
                             Style="{StaticResource ChipStyle}" Checked="Mode_Checked" />
            </StackPanel>

            <!-- Busqueda -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource TextBoxStyle}"
                         Tag="buscar en Civitai..." Margin="0,0,10,0" KeyDown="SearchBox_KeyDown" />

                <Button x:Name="FiltersButton" Grid.Column="1" Content="Filtros" Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}" Click="FiltersButton_Click" />

                <CheckBox x:Name="NsfwCheck" Grid.Column="2" Content="NSFW" VerticalAlignment="Center" Margin="0,0,12,0"
                          Foreground="{DynamicResource Brush.TextSecondary}"
                          FontFamily="{DynamicResource Font.Mono}" FontSize="11" />

                <Button x:Name="SearchButton" Grid.Column="3" Content="Buscar" Style="{StaticResource PrimaryButtonStyle}"
                        Click="Search_Click" />
            </Grid>

            <!-- Panel de filtros (plegable) -->
            <Border x:Name="FiltersPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,12" Padding="14,6,14,12"
                    Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Columna 1: orden, periodo, tipo -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ORDEN" Style="{StaticResource FilterLabel}" Margin="0,4,0,4" />
                        <ComboBox x:Name="SortCombo" SelectedIndex="0" SelectionChanged="SortCombo_SelectionChanged">
                            <ComboBoxItem Content="Mas descargados" Tag="Most Downloaded" />
                            <ComboBoxItem Content="Mejor valorados" Tag="Highest Rated" />
                            <ComboBoxItem Content="Mas gustados" Tag="Most Liked" />
                            <ComboBoxItem Content="Mas comentados" Tag="Most Discussed" />
                            <ComboBoxItem Content="Mas guardados en colecciones" Tag="Most Collected" />
                            <ComboBoxItem Content="Mas imagenes" Tag="Most Images" />
                            <ComboBoxItem Content="Mas nuevos" Tag="Newest" />
                            <ComboBoxItem Content="Mas antiguos" Tag="Oldest" />
                        </ComboBox>

                        <TextBlock Text="PERIODO (de las metricas del orden)" Style="{StaticResource FilterLabel}" />
                        <ComboBox x:Name="PeriodCombo" SelectedIndex="0">
                            <ComboBoxItem Content="Siempre" Tag="AllTime" />
                            <ComboBoxItem Content="Ultimo ano" Tag="Year" />
                            <ComboBoxItem Content="Ultimo mes" Tag="Month" />
                            <ComboBoxItem Content="Ultima semana" Tag="Week" />
                            <ComboBoxItem Content="Ultimo dia" Tag="Day" />
                        </ComboBox>

                        <TextBlock Text="TIPO (ninguno = todos)" Style="{StaticResource FilterLabel}" />
                        <WrapPanel x:Name="TypesPanel">
                            <CheckBox Content="LoRA" Tag="LORA" Style="{StaticResource FilterCheck}"
                                      Checked="TypeCheck_Changed" Unchecked="TypeCheck_Changed" />
                            <CheckBox Content="LyCORIS" Tag="LoCon" Style="{StaticResource FilterCheck}"
                                      Checked="TypeCheck_Changed" Unchecked="TypeCheck_Changed" />
                            <CheckBox Content="DoRA" Tag="DoRA" Style="{StaticResource FilterCheck}"
                                      Checked="TypeCheck_Changed" Unchecked="TypeCheck_Changed" />
                            <CheckBox x:Name="CheckpointCheck" Content="Checkpoint" Tag="Checkpoint"
                                      Style="{StaticResource FilterCheck}"
                                      Checked="TypeCheck_Changed" Unchecked="TypeCheck_Changed" />
                        </WrapPanel>

                        <TextBlock Text="TIPO DE CHECKPOINT" Style="{StaticResource FilterLabel}" Margin="0,4,0,4" />
                        <ComboBox x:Name="CheckpointTypeCombo" SelectedIndex="0" IsEnabled="False">
                            <ComboBoxItem Content="Cualquiera" Tag="" />
                            <ComboBoxItem Content="Standard" Tag="Standard" />
                            <ComboBoxItem Content="Trained" Tag="Trained" />
                            <ComboBoxItem Content="Merge" Tag="Merge" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Columna 2: modelo base -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="MODELO BASE (se pueden marcar varios)" Style="{StaticResource FilterLabel}" Margin="0,4,0,4" />
                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6">
                            <ListBox x:Name="BaseModelList" Height="196" SelectionMode="Multiple"
                                     Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource RowItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource RowText}" Padding="8,4" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <TextBlock x:Name="BaseModelHint" Style="{StaticResource RowText}" FontSize="10" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Brush.TextDim}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Columna 3: etiqueta, creador, opciones y botones -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="ETIQUETA" Style="{StaticResource FilterLabel}" Margin="0,4,0,4" />
                        <TextBox x:Name="TagBox" Style="{StaticResource TextBoxStyle}" Tag="ej: anime" KeyDown="FilterBox_KeyDown" />

                        <TextBlock Text="CREADOR" Style="{StaticResource FilterLabel}" />
                        <TextBox x:Name="UserBox" Style="{StaticResource TextBoxStyle}" Tag="nombre de usuario" KeyDown="FilterBox_KeyDown" />

                        <TextBlock Text="OPCIONES" Style="{StaticResource FilterLabel}" />
                        <CheckBox x:Name="GenCheck" Content="Solo generables en Civitai" Style="{StaticResource FilterCheck}" />
                        <CheckBox x:Name="PlatformCheck" Content="Solo entrenados en Civitai" Style="{StaticResource FilterCheck}" />
                        <CheckBox x:Name="EarlyCheck" Content="Incluir acceso anticipado" Style="{StaticResource FilterCheck}" />

                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Buscar" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"
                                    Click="Search_Click" />
                            <Button Content="Limpiar filtros" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ClearFilters_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Contenido segun el modo -->
            <Grid Grid.Row="3">
                <!-- Resultados -->
                <ListBox x:Name="CardsList" Style="{StaticResource PlainList}"
                         ItemContainerStyle="{StaticResource CardItem}" SelectionMode="Extended"
                         SelectionChanged="CardsList_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Width="160">
                                <StackPanel>
                                    <Grid Height="190">
                                        <Border Background="{DynamicResource Brush.SurfaceActive}" CornerRadius="7,7,0,0" ClipToBounds="True">
                                            <Image Source="{Binding PreviewUrl, Converter={StaticResource UrlImage}, ConverterParameter=320}"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                        <Border Style="{StaticResource BadgeStyle}" HorizontalAlignment="Left"
                                                VerticalAlignment="Top" Margin="6" Background="#CC000000">
                                            <TextBlock Text="{Binding TypeLabel}" FontFamily="{DynamicResource Font.Mono}"
                                                       FontSize="9" Foreground="{DynamicResource Brush.Accent}" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Margin="8,6,8,8">
                                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.TextPrimary}" ToolTip="{Binding Name}" />
                                        <TextBlock Text="{Binding CreatorName}" Style="{StaticResource RowText}" FontSize="10"
                                                   Foreground="{DynamicResource Brush.TextDim}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Colecciones -->
                <Grid x:Name="CollectionsGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Warning}"
                            BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,10">
                        <TextBlock TextWrapping="Wrap" FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="La API publica de Civitai solo da el nombre, el autor y el numero de elementos de una coleccion: NO permite ver que modelos contiene. Abre la coleccion en el navegador, copia los enlaces de sus modelos y pegalos en 'Pegar enlaces' para descargarlos." />
                    </Border>

                    <ListBox x:Name="CollectionsList" Grid.Row="1" Style="{StaticResource PlainList}"
                             ItemContainerStyle="{StaticResource RowItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="10,7">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource RowText}" FontSize="10"
                                                   Foreground="{DynamicResource Brush.TextDim}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" Content="Abrir coleccion en el navegador" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Style="{StaticResource SecondaryButtonStyle}" Click="OpenCollection_Click" />
                </Grid>

                <!-- Pegar enlaces -->
                <Grid x:Name="LinksGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" FontFamily="{DynamicResource Font.Mono}"
                               FontSize="10.5" Foreground="{DynamicResource Brush.TextDim}"
                               Text="Un enlace de modelo de Civitai (civitai.com/models/123) o un id por linea. Se resuelven y aparecen como resultados para que elijas que descargar." />

                    <TextBox x:Name="LinksBox" Grid.Row="1" Style="{StaticResource TextBoxStyle}" AcceptsReturn="True"
                             TextWrapping="NoWrap" VerticalContentAlignment="Top" FontFamily="{DynamicResource Font.Mono}"
                             FontSize="11.5" VerticalScrollBarVisibility="Auto" />

                    <Button x:Name="ResolveButton" Grid.Row="2" Content="Resolver enlaces" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="Resolve_Click" />
                </Grid>

                <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextDim}" />
            </Grid>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="MoreButton" Content="Cargar mas" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,14,0" Visibility="Collapsed" Click="More_Click" />
                <TextBlock x:Name="StatusText" Style="{StaticResource RowText}" FontSize="10.5"
                           Foreground="{DynamicResource Brush.TextDim}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- ===================== DERECHA: detalle ===================== -->
        <Border Grid.Column="1" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <TextBlock x:Name="DetailEmpty" Text="&gt; selecciona un modelo_" FontFamily="{DynamicResource Font.Mono}"
                           FontSize="12" Foreground="{DynamicResource Brush.TextDim}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <ScrollViewer x:Name="DetailScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Border Height="200" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource Brush.SurfaceActive}">
                            <Image Source="{Binding PreviewUrl, Converter={StaticResource UrlImage}, ConverterParameter=600}"
                                   Stretch="Uniform" />
                        </Border>

                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource RowText}" FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap">
                            <Run Text="{Binding TypeLabel, Mode=OneWay}" Foreground="{DynamicResource Brush.Accent}" />
                            <Run Text="  &#x00B7;  " />
                            <Run Text="{Binding CreatorName, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding StatsText}" Style="{StaticResource RowText}" FontSize="10.5" Margin="0,3,0,0"
                                   Foreground="{DynamicResource Brush.TextDim}" />

                        <TextBlock Text="VERSION" Style="{StaticResource DetailLabel}" />
                        <ComboBox x:Name="VersionCombo" DisplayMemberPath="Display" SelectionChanged="VersionCombo_SelectionChanged" />

                        <TextBlock Text="ARCHIVOS" Style="{StaticResource DetailLabel}" />
                        <TextBlock x:Name="FilesText" Style="{StaticResource RowText}" FontSize="10.5" TextWrapping="Wrap" />

                        <TextBlock x:Name="InstalledText" Style="{StaticResource RowText}" FontSize="10.5" TextWrapping="Wrap"
                                   Margin="0,8,0,0" />

                        <TextBlock Text="PALABRAS DE ACTIVACION" Style="{StaticResource DetailLabel}" />
                        <TextBlock x:Name="WordsText" Style="{StaticResource RowText}" FontSize="10.5" TextWrapping="Wrap" />

                        <TextBlock Text="ETIQUETAS" Style="{StaticResource DetailLabel}" />
                        <TextBlock x:Name="TagsText" Style="{StaticResource RowText}" FontSize="10.5" TextWrapping="Wrap" />

                        <WrapPanel Margin="0,16,0,0">
                            <Button x:Name="DownloadButton" Content="Descargar..." Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,0,8,8" Click="Download_Click" />
                            <Button Content="Abrir en Civitai" Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,8" Click="OpenModel_Click" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
