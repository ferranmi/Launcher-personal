<UserControl x:Class="Launcher.Modules.Models.CombinationsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Launcher.Core.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
            <Setter Property="Margin" Value="2,0,0,4" />
        </Style>

        <Style x:Key="PlainList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceActive}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== IZQUIERDA: personajes ===================== -->
        <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton x:Name="SrcLibrary" Content="Desde la biblioteca" Tag="library" GroupName="CmbSource"
                             IsChecked="True" Style="{StaticResource ChipStyle}" Checked="Source_Checked" />
                <RadioButton x:Name="SrcWildcard" Content="Desde un wildcard" Tag="wildcard" GroupName="CmbSource"
                             Style="{StaticResource ChipStyle}" Checked="Source_Checked" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock x:Name="OriginLabel" Text="ORIGEN (serie / franquicia = carpeta)" Style="{StaticResource Label}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="OriginCombo" DisplayMemberPath="Label" SelectionChanged="OriginCombo_SelectionChanged" />
                    <Button Grid.Column="1" Content="Actualizar" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}" Click="Refresh_Click" />
                </Grid>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Style="{StaticResource TextBoxStyle}" Tag="filtrar personajes..."
                         Margin="0,0,8,0" TextChanged="SearchBox_TextChanged" />
                <Button Grid.Column="1" Content="Todos" Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}"
                        Click="MarkAllChars_Click" />
                <Button Grid.Column="2" Content="Ninguno" Style="{StaticResource SecondaryButtonStyle}"
                        Click="MarkNoChars_Click" />
            </Grid>

            <Border Grid.Row="3" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <ListBox x:Name="CharList" Style="{StaticResource PlainList}"
                             SelectionChanged="CharList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"
                                               ToolTip="{Binding Line}" />
                                    <TextBlock Grid.Column="2" Text="{Binding StateLabel}" FontFamily="{DynamicResource Font.Mono}"
                                               FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StateLevel}" Value="1">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StateLevel}" Value="2">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StateLevel}" Value="3">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyChars" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{DynamicResource Font.Mono}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextDim}" Margin="20" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="4" Margin="0,10,0,0">
                <TextBlock Text="LINEA DEL PERSONAJE SELECCIONADO (editable)" Style="{StaticResource Label}" />
                <TextBox x:Name="LineBox" Style="{StaticResource TextBoxStyle}" TextWrapping="Wrap" MinHeight="46"
                         VerticalContentAlignment="Top" FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                         IsEnabled="False" TextChanged="LineBox_TextChanged" />
                <TextBlock x:Name="SelectedInfo" Style="{StaticResource RowText}" FontSize="10.5" Margin="0,6,0,0"
                           Foreground="{DynamicResource Brush.TextDim}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- ===================== DERECHA: combinaciones ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Opciones -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                <StackPanel>
                    <WrapPanel>
                        <CheckBox x:Name="PairsCheck" Content="Parejas" IsChecked="True" Margin="0,0,16,0"
                                  Foreground="{DynamicResource Brush.TextSecondary}" FontFamily="{DynamicResource Font.Mono}"
                                  FontSize="11.5" Checked="Options_Changed" Unchecked="Options_Changed" />
                        <CheckBox x:Name="TriosCheck" Content="Trios" IsChecked="True" Margin="0,0,24,0"
                                  Foreground="{DynamicResource Brush.TextSecondary}" FontFamily="{DynamicResource Font.Mono}"
                                  FontSize="11.5" Checked="Options_Changed" Unchecked="Options_Changed" />
                        <RadioButton x:Name="AutoRadio" Content="Automatico (todas)" GroupName="CmbMode" IsChecked="True"
                                     Margin="0,0,16,0" Foreground="{DynamicResource Brush.TextSecondary}"
                                     FontFamily="{DynamicResource Font.Mono}" FontSize="11.5" />
                        <RadioButton x:Name="ManualRadio" Content="Manual (elijo cuales)" GroupName="CmbMode"
                                     Foreground="{DynamicResource Brush.TextSecondary}"
                                     FontFamily="{DynamicResource Font.Mono}" FontSize="11.5" />
                    </WrapPanel>

                    <TextBlock x:Name="CountsText" Style="{StaticResource RowText}" FontSize="11" Margin="0,8,0,0"
                               Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" />
                    <TextBlock x:Name="WarnText" Style="{StaticResource RowText}" FontSize="10.5" Margin="0,4,0,0"
                               Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" />

                    <Button x:Name="GenerateButton" Content="Generar combinaciones" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="Generate_Click" />
                </StackPanel>
            </Border>

            <!-- Barra de la lista -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ComboInfo" Style="{StaticResource RowText}" FontSize="10.5"
                           Foreground="{DynamicResource Brush.TextDim}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Marcar todas" Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}" Click="MarkAllCombos_Click" />
                    <Button Content="Ninguna" Style="{StaticResource SecondaryButtonStyle}" Click="MarkNoCombos_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <ListBox x:Name="ComboList" Style="{StaticResource PlainList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding Include, Mode=TwoWay}"
                                              IsEnabled="{Binding CanInclude}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="{DynamicResource Font.Mono}"
                                               FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextPrimary}" ToolTip="{Binding Text}" />

                                    <TextBlock Grid.Column="2" Text="{Binding KindLabel}" FontFamily="{DynamicResource Font.Mono}"
                                               FontSize="9.5" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"
                                               Margin="10,0,0,0" />

                                    <TextBlock Grid.Column="3" Text="YA EXISTE" FontFamily="{DynamicResource Font.Mono}" FontSize="9.5"
                                               Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center" Margin="10,0,0,0"
                                               Visibility="{Binding ExistsInDestination, Converter={StaticResource BoolToVis}}" />

                                    <Button Grid.Column="4" Content="Quitar" Margin="10,0,0,0" Padding="8,2" FontSize="10"
                                            Style="{StaticResource SecondaryButtonStyle}" Click="RemoveCombo_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyCombos" Text="&gt; elige personajes y pulsa Generar_" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontFamily="{DynamicResource Font.Mono}" FontSize="12.5"
                               Foreground="{DynamicResource Brush.TextDim}" />
                </Grid>
            </Border>

            <!-- Destino -->
            <Border Grid.Row="3" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="DESTINO (parejas y trios van en el mismo wildcard)" Style="{StaticResource Label}" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="DestExisting" Content="Wildcard existente" Tag="existing" GroupName="CmbDest"
                                     IsChecked="True" Style="{StaticResource ChipStyle}" Checked="Dest_Checked" />
                        <RadioButton x:Name="DestNew" Content="Nuevo wildcard" Tag="new" GroupName="CmbDest"
                                     Style="{StaticResource ChipStyle}" Checked="Dest_Checked" />
                    </StackPanel>

                    <ComboBox x:Name="DestCombo" DisplayMemberPath="Name" SelectionChanged="DestCombo_SelectionChanged" />
                    <TextBox x:Name="NewNameBox" Style="{StaticResource TextBoxStyle}" Visibility="Collapsed"
                             Tag="nombre, p.ej. combos/tonikaku_kawaii" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SaveButton" Content="Guardar en el wildcard" Style="{StaticResource PrimaryButtonStyle}"
                                Click="Save_Click" />
                        <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource RowText}" FontSize="10.5"
                                   Margin="12,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextDim}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
