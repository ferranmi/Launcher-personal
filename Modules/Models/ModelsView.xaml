<UserControl x:Class="Launcher.Modules.Models.ModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Launcher.Modules.Models">

    <UserControl.Resources>
        <!-- Lista sin el aspecto por defecto de ListBox (fondo blanco, seleccion azul). Sigue
             virtualizando, asi que aguanta miles de modelos. Se sustituye en el paso 2. -->
        <Style x:Key="PlainList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="&gt; modelos_" Margin="0,0,0,12"
                   FontFamily="{DynamicResource Font.Mono}" FontSize="14"
                   Foreground="{DynamicResource Brush.TextSecondary}" />

        <!-- ===================== PESTANAS ===================== -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <RadioButton Content="Dashboard" Tag="dashboard" GroupName="ModelsTabs" Style="{StaticResource ChipStyle}" Checked="Tab_Checked" />
            <RadioButton Content="Civitai" Tag="civitai" GroupName="ModelsTabs" Style="{StaticResource ChipStyle}" Checked="Tab_Checked" />
            <RadioButton x:Name="TabLibrary" Content="Biblioteca" Tag="library" GroupName="ModelsTabs" Style="{StaticResource ChipStyle}" Checked="Tab_Checked" />
            <RadioButton Content="Wildcards" Tag="wildcards" GroupName="ModelsTabs" Style="{StaticResource ChipStyle}" Checked="Tab_Checked" />
            <RadioButton Content="Parejas y trios" Tag="combos" GroupName="ModelsTabs" Style="{StaticResource ChipStyle}" Checked="Tab_Checked" />
            <RadioButton Content="Configuracion" Tag="settings" GroupName="ModelsTabs" Style="{StaticResource ChipStyle}" Checked="Tab_Checked" />
        </StackPanel>

        <!-- ===================== CONTENIDO ===================== -->
        <Grid x:Name="PanelHost" Grid.Row="2">

            <Grid Tag="dashboard" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Placeholder}" Text="&gt; dashboard: en construccion_" />
            </Grid>

            <Grid Tag="civitai" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Placeholder}" Text="&gt; civitai y descargas: en construccion_" />
            </Grid>

            <local:LibraryPanel x:Name="LibraryTab" Tag="library" Visibility="Collapsed" />

            <local:WildcardsPanel x:Name="WildcardsTab" Tag="wildcards" Visibility="Collapsed" />

            <Grid Tag="combos" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Placeholder}" Text="&gt; parejas y trios: en construccion_" />
            </Grid>

            <!-- Configuracion -->
            <ScrollViewer Tag="settings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="Carpeta de instalacion de AUTOMATIC1111" Style="{StaticResource FieldLabelStyle}" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InstallPathBox" Style="{StaticResource TextBoxStyle}"
                                 Tag="p.ej. C:\stable-diffusion-webui" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="..." Style="{StaticResource SecondaryButtonStyle}"
                                Click="BrowseInstall_Click" />
                    </Grid>
                    <TextBlock Text="De aqui salen las carpetas de LoRA, Checkpoints, LyCORIS y wildcards, salvo que las cambies a mano."
                               FontFamily="{DynamicResource Font.Mono}" FontSize="10" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,14" />

                    <Button Content="Guardar y reescanear" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left" Click="SaveSettings_Click" />

                    <TextBlock Text="CARPETAS EN USO" Margin="0,22,0,6"
                               FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                               Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock x:Name="FoldersText" FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                               TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,10,0,0"
                   FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                   Foreground="{DynamicResource Brush.TextDim}" />
    </Grid>
</UserControl>
