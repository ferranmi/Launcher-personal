<UserControl x:Class="Launcher.Modules.Models.ModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Launcher.Modules.Models">

    <UserControl.Resources>
        <!-- Lista sin el aspecto por defecto de ListBox (fondo blanco, seleccion azul). Sigue
             virtualizando, asi que aguanta miles de modelos. Se sustituye en el paso 2. -->
        <Style x:Key="PlainList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="&gt; modelos_" Margin="0,0,0,12"
                   FontFamily="{DynamicResource Font.Mono}" FontSize="14"
                   Foreground="{DynamicResource Brush.TextSecondary}" />

        <!-- ===================== PESTANAS ===================== -->
        <WrapPanel x:Name="TabsPanel" Grid.Row="1" Margin="0,0,0,10">
            <RadioButton x:Name="TabDashboard" Content="Dashboard" Tag="dashboard" GroupName="ModelsTabs" Style="{StaticResource ChipStyle}" Checked="Tab_Checked" />
            <RadioButton x:Name="TabCivitai" Content="Civitai" Tag="civitai" GroupName="ModelsTabs" Style="{StaticResource ChipStyle}" Checked="Tab_Checked" />
            <RadioButton x:Name="TabDownloads" Content="Descargas" Tag="downloads" GroupName="ModelsTabs" Style="{StaticResource ChipStyle}" Checked="Tab_Checked" />
            <RadioButton x:Name="TabLibrary" Content="Biblioteca" Tag="library" GroupName="ModelsTabs" Style="{StaticResource ChipStyle}" Checked="Tab_Checked" />
            <RadioButton Content="Wildcards" Tag="wildcards" GroupName="ModelsTabs" Style="{StaticResource ChipStyle}" Checked="Tab_Checked" />
            <RadioButton x:Name="TabReferences" Content="Referencias" Tag="references" GroupName="ModelsTabs" Style="{StaticResource ChipStyle}" Checked="Tab_Checked" />
            <RadioButton Content="Parejas y trios" Tag="combos" GroupName="ModelsTabs" Style="{StaticResource ChipStyle}" Checked="Tab_Checked" />
            <RadioButton Content="Configuracion" Tag="settings" GroupName="ModelsTabs" Style="{StaticResource ChipStyle}" Checked="Tab_Checked" />
        </WrapPanel>

        <!-- ===================== CONTENIDO ===================== -->
        <Grid x:Name="PanelHost" Grid.Row="2">

            <local:ModelsDashboardPanel x:Name="DashboardTab" Tag="dashboard" Visibility="Collapsed" />

            <local:CivitaiPanel x:Name="CivitaiTab" Tag="civitai" Visibility="Collapsed" />

            <local:DownloadsPanel x:Name="DownloadsTab" Tag="downloads" Visibility="Collapsed" />

            <local:LibraryPanel x:Name="LibraryTab" Tag="library" Visibility="Collapsed" />

            <local:WildcardsPanel x:Name="WildcardsTab" Tag="wildcards" Visibility="Collapsed" />

            <local:ReferencesPanel x:Name="ReferencesTab" Tag="references" Visibility="Collapsed" />

            <local:CombinationsPanel x:Name="CombosTab" Tag="combos" Visibility="Collapsed" />

            <!-- Configuracion -->
            <ScrollViewer Tag="settings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="Carpeta de instalacion de AUTOMATIC1111" Style="{StaticResource FieldLabelStyle}" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InstallPathBox" Style="{StaticResource TextBoxStyle}"
                                 Tag="p.ej. C:\stable-diffusion-webui" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="..." Style="{StaticResource SecondaryButtonStyle}"
                                Click="BrowseInstall_Click" />
                    </Grid>
                    <TextBlock Text="De aqui salen las carpetas de LoRA, Checkpoints, LyCORIS y wildcards, salvo que las cambies a mano."
                               FontFamily="{DynamicResource Font.Mono}" FontSize="10" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,14" />

                    <TextBlock Text="CARPETAS PERSONALIZADAS (opcional)" Margin="0,4,0,10"
                               FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                               Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Si anades carpetas a una lista, se usan ellas en lugar de la ruta estandar. La primera es la principal; las demas (otras instalaciones, SDXL, Pony...) se marcan como otra ubicacion."
                               FontFamily="{DynamicResource Font.Mono}" FontSize="10" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,12" />
                    <local:FolderListEditor x:Name="LoraEditor" />
                    <local:FolderListEditor x:Name="CheckpointEditor" />
                    <local:FolderListEditor x:Name="LyCorisEditor" />
                    <local:FolderListEditor x:Name="WildcardEditor" />

                    <Button Content="Guardar y reescanear" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left" Click="SaveSettings_Click" />

                    <TextBlock Text="CARPETAS EN USO" Margin="0,22,0,6"
                               FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                               Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock x:Name="FoldersText" FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                               TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBlock Text="CIVITAI" Margin="0,26,0,8" FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                               Foreground="{DynamicResource Brush.Accent}" />

                    <TextBlock Text="API Key de Civitai" Style="{StaticResource FieldLabelStyle}" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ApiKeyBox" Padding="10,8" FontFamily="{DynamicResource Font.Mono}" FontSize="12"
                                     Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.TextPrimary}"
                                     BorderBrush="{DynamicResource Brush.Border}" CaretBrush="{DynamicResource Brush.Accent}" />
                        <Button Grid.Column="1" Content="Guardar clave" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="SaveApiKey_Click" />
                        <Button Grid.Column="2" Content="Probar conexion" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="TestApiKey_Click" />
                    </Grid>
                    <TextBlock x:Name="ApiKeyStatus" FontFamily="{DynamicResource Font.Mono}" FontSize="10.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,4" />
                    <TextBlock FontFamily="{DynamicResource Font.Mono}" FontSize="10" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextDim}"
                               Text="Se guarda en el Administrador de credenciales de Windows, no en los archivos del Launcher. Dejala vacia y pulsa Guardar para borrarla. Sin clave, la mayoria de descargas devuelven un error 401." />

                    <TextBlock Text="DESCARGAS" Margin="0,26,0,8" FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                               Foreground="{DynamicResource Brush.Accent}" />

                    <TextBlock Text="Descargas simultaneas maximas (1-8)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="MaxDownloadsBox" Style="{StaticResource TextBoxStyle}" Width="80" HorizontalAlignment="Left"
                             Margin="0,0,0,10" />

                    <CheckBox x:Name="AutoConcurrencyCheck" Margin="0,0,0,10"
                              Content="Ajustar solas las descargas simultaneas segun la velocidad (nunca por encima del maximo)"
                              Foreground="{DynamicResource Brush.TextSecondary}" FontFamily="{DynamicResource Font.Mono}" FontSize="11" />

                    <TextBlock Text="Limite de velocidad total en KB/s (0 = sin limite)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="SpeedLimitBox" Style="{StaticResource TextBoxStyle}" Width="120" HorizontalAlignment="Left"
                             Margin="0,0,0,10" />

                    <TextBlock Text="Reintentos ante errores de red (0-10)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="RetriesBox" Style="{StaticResource TextBoxStyle}" Width="80" HorizontalAlignment="Left"
                             Margin="0,0,0,10" />

                    <TextBlock Text="Categorias de carpetas, separadas por comas" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="CategoriesBox" Style="{StaticResource TextBoxStyle}" Margin="0,0,0,4" />
                    <TextBlock FontFamily="{DynamicResource Font.Mono}" FontSize="10" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,12"
                               Text="Cada descarga de LoRA/LyCORIS va a una subcarpeta de su categoria. En Personajes se anade ademas la carpeta del origen (serie). Los checkpoints van sin categoria. Nunca se crean carpetas por coleccion." />

                    <Button Content="Guardar ajustes de descargas" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left" Click="SaveDownloadSettings_Click" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,10,0,0"
                   FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                   Foreground="{DynamicResource Brush.TextDim}" />
    </Grid>
</UserControl>
