<UserControl x:Class="Launcher.Modules.Models.DownloadsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Launcher.Core.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="PlainList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Rectangle x:Name="PART_Indicator" Fill="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Left" RadiusX="3" RadiusY="3" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SummaryText" Style="{StaticResource RowText}" FontSize="11.5"
                       Foreground="{DynamicResource Brush.TextSecondary}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Pausar todo" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="PauseAll_Click" />
                <Button Content="Reanudar todo" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="ResumeAll_Click" />
                <Button Content="Limpiar terminadas" Style="{StaticResource SecondaryButtonStyle}" Click="ClearFinished_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <ListBox x:Name="DownloadsList" Style="{StaticResource PlainList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="14,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ModelName}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                                            <TextBlock Style="{StaticResource RowText}" FontSize="10"
                                                       Foreground="{DynamicResource Brush.TextDim}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding TypeLabel, Mode=OneWay}" />
                                                <Run Text="  &#x00B7;  " />
                                                <Run Text="{Binding VersionName, Mode=OneWay}" />
                                                <Run Text="  &#x00B7;  " />
                                                <Run Text="{Binding FileName, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding StateLabel}" FontFamily="{DynamicResource Font.Mono}"
                                                   FontSize="10.5" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StateLevel}" Value="1">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StateLevel}" Value="2">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StateLevel}" Value="3">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <ProgressBar Style="{StaticResource AccentProgressBar}" Minimum="0" Maximum="100"
                                                 Value="{Binding ProgressPercent, Mode=OneWay}" Margin="0,8,0,0" />

                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource RowText}" FontSize="10.5" />
                                            <TextBlock Text="{Binding SpeedText}" Style="{StaticResource RowText}" FontSize="10.5"
                                                       Foreground="{DynamicResource Brush.Accent}" Margin="12,0,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Pausar" Style="{StaticResource MiniButton}" Click="Pause_Click"
                                                    Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="Reanudar" Style="{StaticResource MiniButton}" Click="Resume_Click"
                                                    Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="Reintentar" Style="{StaticResource MiniButton}" Click="Resume_Click"
                                                    Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="Al final de la cola" Style="{StaticResource MiniButton}" Click="ToEnd_Click"
                                                    Visibility="{Binding CanMoveToEnd, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="Copiar linea" Style="{StaticResource MiniButton}" Click="CopyLine_Click"
                                                    Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="Abrir carpeta" Style="{StaticResource MiniButton}" Click="OpenFolder_Click" />
                                            <Button Content="Cancelar" Style="{StaticResource MiniButton}" Click="Cancel_Click"
                                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="Quitar" Style="{StaticResource MiniButton}" Margin="0" Click="Remove_Click"
                                                    Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding Error}" Style="{StaticResource RowText}" FontSize="10.5"
                                               Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyText" Text="&gt; no hay descargas_" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontFamily="{DynamicResource Font.Mono}" FontSize="13"
                           Foreground="{DynamicResource Brush.TextDim}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
