<UserControl x:Class="Launcher.Modules.Models.FolderListEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="PathItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceActive}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0,0,0,18">
        <TextBlock x:Name="TitleText" Style="{StaticResource FieldLabelStyle}" />

        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="6">
            <ListBox x:Name="FoldersList" MinHeight="34" MaxHeight="120" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource PathItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Margin="8,5" TextTrimming="CharacterEllipsis"
                                   FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Anadir carpeta..." Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="Add_Click" />
            <Button Content="Quitar" Style="{StaticResource SecondaryButtonStyle}" Click="Remove_Click" />
            <TextBlock Text="vacio = ruta estandar de A1111" Margin="12,0,0,0" VerticalAlignment="Center"
                       FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                       Foreground="{DynamicResource Brush.TextDim}" />
        </StackPanel>
    </StackPanel>
</UserControl>
