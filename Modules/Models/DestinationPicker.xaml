<UserControl x:Class="Launcher.Modules.Models.DestinationPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock x:Name="TitleText" FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                   Foreground="{DynamicResource Brush.TextDim}" Margin="2,0,0,6" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="ExistingRadio" Content="Existente" Style="{StaticResource ChipStyle}" Checked="Mode_Checked" />
            <RadioButton x:Name="NewRadio" Content="Nuevo" Style="{StaticResource ChipStyle}" Checked="Mode_Checked" />
        </StackPanel>

        <ComboBox x:Name="FileCombo" DisplayMemberPath="Name" SelectionChanged="FileCombo_SelectionChanged" />
        <TextBox x:Name="NewNameBox" Style="{StaticResource TextBoxStyle}" Visibility="Collapsed"
                 Tag="nombre, p.ej. combos/serie" />
    </StackPanel>
</UserControl>
