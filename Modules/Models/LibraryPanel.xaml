<UserControl x:Class="Launcher.Modules.Models.LibraryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Launcher.Core.Converters"
             xmlns:local="clr-namespace:Launcher.Modules.Models">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:PreviewConverter x:Key="Preview" />

        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
            <Setter Property="Margin" Value="0,12,0,2" />
        </Style>

        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Lista sin el aspecto por defecto de ListBox. Sigue virtualizando (vista lista). -->
        <Style x:Key="PlainList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <!-- Contenedor de tarjeta: borde que se ilumina con el color de acento al seleccionar -->
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Sel" BorderThickness="1" CornerRadius="9" BorderBrush="Transparent"
                                Margin="0,0,10,10" Cursor="Hand">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sel" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Sel" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Contenedor de fila (vista lista) -->
        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Cursor="Hand">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceActive}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- ===================== IZQUIERDA: filtros + listado ===================== -->
        <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Buscar / carpeta / orden / reescanear -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource TextBoxStyle}"
                         Tag="buscar modelo..." Margin="0,0,10,0" TextChanged="SearchBox_TextChanged" />

                <ComboBox x:Name="CategoryCombo" Grid.Column="1" Width="170" Margin="0,0,10,0"
                          SelectionChanged="CategoryCombo_SelectionChanged" />

                <ComboBox x:Name="SortCombo" Grid.Column="2" Width="140" Margin="0,0,10,0"
                          SelectionChanged="SortCombo_SelectionChanged">
                    <ComboBoxItem Content="Nombre" />
                    <ComboBoxItem Content="Mayor tamano" />
                    <ComboBoxItem Content="Mas recientes" />
                    <ComboBoxItem Content="Tipo" />
                </ComboBox>

                <Button x:Name="RescanButton" Grid.Column="3" Content="Reescanear"
                        Style="{StaticResource SecondaryButtonStyle}" Click="Rescan_Click" />
            </Grid>

            <!-- Tipo / vista -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Todos" Tag="all" GroupName="LibType" IsChecked="True"
                                 Style="{StaticResource ChipStyle}" Checked="Type_Checked" />
                    <RadioButton Content="LoRA" Tag="lora" GroupName="LibType"
                                 Style="{StaticResource ChipStyle}" Checked="Type_Checked" />
                    <RadioButton Content="Checkpoints" Tag="checkpoint" GroupName="LibType"
                                 Style="{StaticResource ChipStyle}" Checked="Type_Checked" />
                    <RadioButton Content="LyCORIS" Tag="lycoris" GroupName="LibType"
                                 Style="{StaticResource ChipStyle}" Checked="Type_Checked" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton x:Name="ViewCards" Content="Tarjetas" Tag="cards" GroupName="LibView"
                                 Style="{StaticResource ChipStyle}" Checked="View_Checked" />
                    <RadioButton x:Name="ViewList" Content="Lista" Tag="list" GroupName="LibView"
                                 Style="{StaticResource ChipStyle}" Margin="0" Checked="View_Checked" />
                </StackPanel>
            </Grid>

            <!-- Listados -->
            <Grid Grid.Row="2">
                <!-- Vista tarjetas -->
                <ListBox x:Name="CardsList" Style="{StaticResource PlainList}"
                         ItemContainerStyle="{StaticResource CardItem}"
                         SelectionChanged="List_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Width="150">
                                <StackPanel>
                                    <Grid Height="170">
                                        <Border CornerRadius="7,7,0,0" ClipToBounds="True">
                                            <Grid>
                                                <Border Background="{DynamicResource Brush.SurfaceActive}"
                                                        Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                                    <TextBlock Text="{Binding Initial}" FontFamily="{DynamicResource Font.Mono}"
                                                               FontSize="38" FontWeight="Bold"
                                                               Foreground="{DynamicResource Brush.TextDim}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Image Source="{Binding PreviewPath, Converter={StaticResource Preview}, ConverterParameter=300}"
                                                       Stretch="UniformToFill"
                                                       Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource BadgeStyle}" HorizontalAlignment="Left"
                                                VerticalAlignment="Top" Margin="6" Background="#CC000000">
                                            <TextBlock Text="{Binding TypeLabel}" FontFamily="{DynamicResource Font.Mono}"
                                                       FontSize="9" Foreground="{DynamicResource Brush.Accent}" />
                                        </Border>

                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                                Background="#CC000000" BorderBrush="{DynamicResource Brush.Warning}"
                                                BorderThickness="1" CornerRadius="3" Padding="5,2"
                                                ToolTip="Hay otro archivo con el mismo nombre"
                                                Visibility="{Binding IsDuplicateName, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="DUP" FontFamily="{DynamicResource Font.Mono}" FontSize="9"
                                                       Foreground="{DynamicResource Brush.Warning}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Margin="8,6,8,8">
                                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.TextPrimary}" ToolTip="{Binding Name}" />
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource RowText}" FontSize="10"
                                                   Foreground="{DynamicResource Brush.TextDim}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Vista lista -->
                <ListBox x:Name="ListList" Style="{StaticResource PlainList}"
                         ItemContainerStyle="{StaticResource RowItem}"
                         Visibility="Collapsed" SelectionChanged="List_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="6,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="30" Height="30" CornerRadius="4" Margin="0,0,10,0" ClipToBounds="True"
                                            Background="{DynamicResource Brush.SurfaceActive}">
                                        <Image Source="{Binding PreviewPath, Converter={StaticResource Preview}, ConverterParameter=60}"
                                               Stretch="UniformToFill" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                                            <TextBlock Text="  DUP" Style="{StaticResource RowText}" FontSize="9"
                                                       Foreground="{DynamicResource Brush.Warning}"
                                                       Visibility="{Binding IsDuplicateName, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding DisplayFolder}" Style="{StaticResource RowText}" FontSize="10"
                                                   Foreground="{DynamicResource Brush.TextDim}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding TypeLabel}" Style="{StaticResource RowText}"
                                               Foreground="{DynamicResource Brush.Accent}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource RowText}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="13"
                           Foreground="{DynamicResource Brush.TextDim}" />
            </Grid>

            <!-- Pie: mostrar mas + contador -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="ShowMoreButton" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,14,0"
                        Visibility="Collapsed" Click="ShowMore_Click" />
                <TextBlock x:Name="CountText" Style="{StaticResource RowText}" FontSize="10.5"
                           Foreground="{DynamicResource Brush.TextDim}" />
            </StackPanel>
        </Grid>

        <!-- ===================== DERECHA: panel de detalles ===================== -->
        <Border Grid.Column="1" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <TextBlock x:Name="DetailEmpty" Text="&gt; selecciona un modelo_"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="12"
                           Foreground="{DynamicResource Brush.TextDim}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <ScrollViewer x:Name="DetailScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Border Height="230" CornerRadius="8" ClipToBounds="True"
                                Background="{DynamicResource Brush.SurfaceActive}">
                            <Grid>
                                <TextBlock Text="{Binding Initial}" FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="48" FontWeight="Bold" Foreground="{DynamicResource Brush.TextDim}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                <Image Source="{Binding PreviewPath, Converter={StaticResource Preview}, ConverterParameter=600}"
                                       Stretch="Uniform"
                                       Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,12,0,0" />

                        <TextBlock x:Name="DuplicateText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8,0,0"
                                   FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                                   Foreground="{DynamicResource Brush.Warning}" />

                        <TextBlock Text="TIPO" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource DetailValue}"
                                   Foreground="{DynamicResource Brush.Accent}" />

                        <TextBlock Text="CARPETA" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding DisplayFolder}" Style="{StaticResource DetailValue}" />

                        <TextBlock Text="ARCHIVO" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource DetailValue}" />

                        <TextBlock Text="RUTA" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding FullPath}" Style="{StaticResource DetailValue}" FontSize="10.5"
                                   FontFamily="{DynamicResource Font.Mono}" />

                        <TextBlock Text="TAMANO" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource DetailValue}" />

                        <TextBlock Text="MODIFICADO" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding Modified, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                   Style="{StaticResource DetailValue}" />

                        <TextBlock Text="REFERENCIAS EN WILDCARDS" Style="{StaticResource DetailLabel}" />
                        <TextBlock x:Name="RefsText" Style="{StaticResource DetailValue}" FontSize="11"
                                   FontFamily="{DynamicResource Font.Mono}" />

                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="Abrir ubicacion" Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,8" Click="OpenLocation_Click" />
                            <Button Content="Copiar nombre" Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,8" Click="CopyName_Click" />
                            <Button x:Name="CopyTagButton" Content="Copiar etiqueta" Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,8" Click="CopyTag_Click" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
