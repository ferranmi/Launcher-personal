<UserControl x:Class="Launcher.Modules.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Launcher.Core.Converters"
             xmlns:svc="clr-namespace:Launcher.Core.Services"
             xmlns:ctl="clr-namespace:Launcher.UI.Controls"
             xmlns:search="clr-namespace:Launcher.Modules.Search">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:PathToBitmapConverter x:Key="PathToBitmap" />
        <conv:PlayPauseGlyphConverter x:Key="PlayPauseGlyph" />

        <!-- Azul de UPLINK y variantes tenues. Mover a Theme.Dark.xaml cuando se confirme el color. -->
        <SolidColorBrush x:Key="Brush.Uplink" Color="#FF4C9AFF" />
        <SolidColorBrush x:Key="Brush.UplinkDim" Color="#334C9AFF" />
        <SolidColorBrush x:Key="Brush.WarningDim" Color="#33E0B84C" />
        <SolidColorBrush x:Key="Brush.DangerDim" Color="#33E5484D" />

        <!-- ===================== FONDO (vectorial, sin imagenes) ===================== -->
        <!-- Rejilla tipo mapa tactico: lineas verdes muy tenues cada 48 px -->
        <DrawingBrush x:Key="Bg.Grid" TileMode="Tile"
                      Viewport="0,0,48,48" ViewportUnits="Absolute"
                      Viewbox="0,0,48,48" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#123ECF7E" Thickness="1" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 0,0 L 48,0 M 0,0 L 0,48" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Resplandor verde en la parte superior (como la luz de un monitor) -->
        <LinearGradientBrush x:Key="Bg.TopGlow" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#1F3ECF7E" Offset="0" />
            <GradientStop Color="#003ECF7E" Offset="0.45" />
        </LinearGradientBrush>

        <!-- Vineta: oscurece los bordes para centrar la atencion -->
        <RadialGradientBrush x:Key="Bg.Vignette" RadiusX="0.85" RadiusY="0.85">
            <GradientStop Color="#00000000" Offset="0.5" />
            <GradientStop Color="#AA000000" Offset="1" />
        </RadialGradientBrush>

        <!-- Scanlines: una linea oscura cada 3 px, casi imperceptible -->
        <DrawingBrush x:Key="Bg.Scanlines" TileMode="Tile"
                      Viewport="0,0,6,3" ViewportUnits="Absolute"
                      Viewbox="0,0,6,3" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#14000000">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,6,1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- ===================== TEXTO ===================== -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
        </Style>
        <!-- Etiqueta [ X ] clicable: mismo aspecto que SectionTitle, navega al menu (svc:Navigator.To) -->
        <Style x:Key="SectionLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="ToolTip" Value="Abrir este menu" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Divisor vertical (accesos | info). Esta aqui y no solo en Shared.Styles para que el
             dashboard cargue aunque Shared.Styles.xaml sea una version antigua. -->
        <Style x:Key="VPanelSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="ShowsPreview" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Border x:Name="Line" Background="{DynamicResource Brush.Border}"
                                    CornerRadius="1" Width="2" Height="30"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Divisor horizontal (entre bloques apilados): igual de autonomo -->
        <Style x:Key="PanelSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="ShowsPreview" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Border x:Name="Line" Background="{DynamicResource Brush.Border}"
                                    CornerRadius="1" Width="30" Height="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>
        <Style x:Key="TileNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="TileDetail" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- ===================== TARJETAS ===================== -->
        <Style x:Key="TileStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barra fina (misma plantilla que AccentProgressBar del Monitor) -->
        <Style x:Key="ThinBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Rectangle x:Name="PART_Indicator" Fill="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Left" RadiusX="3" RadiusY="3" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== REPRODUCTOR (copiado de MediaView) ===================== -->
        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Icons}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButtonStyle" TargetType="Button" BasedOn="{StaticResource TransportButtonStyle}">
            <Setter Property="Width" Value="50" />
            <Setter Property="Height" Value="50" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="Foreground" Value="#FF07130D" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Effect" Value="{DynamicResource Effect.AccentGlow}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="25">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MinimalSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="16" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource Brush.Accent}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource Brush.Border}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource Brush.Accent}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== PLANTILLAS ===================== -->
        <DataTemplate x:Key="GameTileTemplate">
            <Border Width="86" Margin="0,0,10,10" Background="Transparent" Cursor="Hand"
                    ToolTip="{Binding Name}" MouseLeftButtonDown="GameTile_MouseLeftButtonDown">
                <StackPanel>
                    <Border Style="{StaticResource TileStyle}" Height="112" ClipToBounds="True">
                        <Grid>
                            <Border Background="{DynamicResource Brush.SurfaceActive}" Margin="1"
                                    Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                <TextBlock Text="{Binding Initial}" FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="30" FontWeight="Bold" Foreground="{DynamicResource Brush.TextDim}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Image Source="{Binding CoverPath, Converter={StaticResource PathToBitmap}}"
                                   Stretch="UniformToFill" Margin="1"
                                   Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Name}" Margin="0,5,0,0" FontSize="11"
                               Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Comandos y carpetas comparten plantilla: ambos tienen Icon y Name -->
        <DataTemplate x:Key="IconTileTemplate">
            <Border Style="{StaticResource TileStyle}" Width="84" Height="70" Margin="0,0,8,8"
                    ToolTip="{Binding Name}" MouseLeftButtonDown="IconTile_MouseLeftButtonDown">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Icon}" FontFamily="{DynamicResource Font.Icons}" FontSize="20"
                               Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" Margin="0,6,0,0" FontSize="11" MaxWidth="74"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="LogRowTemplate">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="{DynamicResource Font.Mono}"
                           FontSize="10" Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="{Binding TagBg}" CornerRadius="3" Padding="5,1" Margin="8,0,8,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Tag}" FontFamily="{DynamicResource Font.Mono}" FontSize="9"
                               Foreground="{Binding TagFg}" />
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="UplinkRowTemplate">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontFamily="{DynamicResource Font.Icons}"
                           FontSize="16" Foreground="{Binding IconBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                    <TextBlock Text="{Binding Detail}" FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextDim}" />
                </StackPanel>
                <Ellipse Grid.Column="2" Width="7" Height="7" Fill="{Binding DotBrush}"
                         VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ProcCellTemplate">
            <Border Style="{StaticResource CardStyle}" Padding="9,7" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                    <ProgressBar Style="{StaticResource ThinBar}" Minimum="0" Maximum="100"
                                 Value="{Binding Cpu, Mode=OneWay}" Foreground="{Binding Bar}" Margin="0,5,0,4" />
                    <TextBlock Text="{Binding Info}" FontFamily="{DynamicResource Font.Mono}" FontSize="9.5"
                               TextTrimming="CharacterEllipsis" Foreground="{Binding InfoBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="480" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="250" MinWidth="200" MaxWidth="440" />
        </Grid.ColumnDefinitions>
        <!-- Cabecera y metricas ocupan todo el ancho (tambien sobre la columna del reproductor);
             el reproductor solo ocupa la fila central; los procesos, otra vez todo el ancho. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />                          <!-- 0 cabecera -->
            <RowDefinition Height="84" MinHeight="64" MaxHeight="220" /> <!-- 1 monitor (ajustable) -->
            <RowDefinition Height="8" />                             <!-- 2 divisor monitor | centro -->
            <RowDefinition Height="*" MinHeight="170" />             <!-- 3 centro + reproductor -->
            <RowDefinition Height="Auto" />                          <!-- 4 procesos -->
        </Grid.RowDefinitions>

        <!-- Fondo: rejilla + brillo superior + vineta (detras de todo, sin capturar el raton) -->
        <Rectangle Grid.ColumnSpan="3" Grid.RowSpan="5" Fill="{StaticResource Bg.Grid}" IsHitTestVisible="False" />
        <Rectangle Grid.ColumnSpan="3" Grid.RowSpan="5" Fill="{StaticResource Bg.TopGlow}" IsHitTestVisible="False" />
        <Rectangle Grid.ColumnSpan="3" Grid.RowSpan="5" Fill="{StaticResource Bg.Vignette}" IsHitTestVisible="False" />

        <!-- ===================== CONTENIDO (cabecera, metricas, centro, procesos) ===================== -->

            <!-- Cabecera: titulo + estado global + reloj -->
            <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&gt; dashboard_" FontFamily="{DynamicResource Font.Mono}"
                           FontSize="14" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                <!-- Buscador global: ocupa el espacio libre entre el titulo y los controles de la derecha -->
                <search:SearchWidget Grid.Column="1" MinWidth="200" MaxWidth="480"
                                     Margin="24,0,24,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="AddWidgetButton" Content="+ widget" Style="{StaticResource LinkButton}"
                            VerticalAlignment="Center" Margin="0,0,16,0"
                            ToolTip="Anadir un widget al tablero (tambien: clic derecho en el tablero)"
                            Click="AddWidget_Click" />
                    <Border x:Name="GlobalStatusBorder" CornerRadius="4" Padding="10,3" BorderThickness="1"
                            VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="GlobalStatusText" Text="ONLINE" FontFamily="{DynamicResource Font.Mono}"
                                   FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="ClockText" Text="--:--:--" FontFamily="{DynamicResource Font.Mono}"
                                   FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"
                                   HorizontalAlignment="Right" />
                        <TextBlock x:Name="DateText" Text="" FontFamily="{DynamicResource Font.Mono}" FontSize="9.5"
                                   Foreground="{DynamicResource Brush.TextDim}" HorizontalAlignment="Right" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Metricas -->
            <Grid Grid.Row="1" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10,8" Margin="0,0,8,0">
                    <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel MinWidth="96">
                            <TextBlock Text="CPU" Style="{StaticResource TileLabel}" />
                            <TextBlock x:Name="CpuText" Text="0%" Style="{StaticResource TileNumber}" />
                            <TextBlock x:Name="CpuDetail" Text="" Style="{StaticResource TileDetail}" />
                        </StackPanel>
                    </Viewbox>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="10,8" Margin="0,0,8,0">
                    <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel MinWidth="96">
                            <TextBlock Text="RAM" Style="{StaticResource TileLabel}" />
                            <TextBlock x:Name="RamText" Text="0%" Style="{StaticResource TileNumber}" />
                            <TextBlock x:Name="RamDetail" Text="" Style="{StaticResource TileDetail}" />
                        </StackPanel>
                    </Viewbox>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="10,8" Margin="0,0,8,0">
                    <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel MinWidth="96">
                            <TextBlock Text="GPU" Style="{StaticResource TileLabel}" />
                            <TextBlock x:Name="GpuText" Text="0%" Style="{StaticResource TileNumber}" />
                            <TextBlock x:Name="GpuDetail" Text="" Style="{StaticResource TileDetail}" />
                        </StackPanel>
                    </Viewbox>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource CardStyle}" Padding="10,8" Margin="0,0,8,0">
                    <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel MinWidth="96">
                            <TextBlock Text="VRAM" Style="{StaticResource TileLabel}" />
                            <TextBlock x:Name="VramText" Text="0%" Style="{StaticResource TileNumber}" />
                            <TextBlock x:Name="VramDetail" Text="" Style="{StaticResource TileDetail}" />
                        </StackPanel>
                    </Viewbox>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="10,8">
                    <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel MinWidth="96">
                            <TextBlock Text="RED" Style="{StaticResource TileLabel}" />
                            <TextBlock x:Name="NetDownText" Text="0 KB/s" Style="{StaticResource TileNumber}" FontSize="15" Margin="0,5,0,0" />
                            <TextBlock x:Name="NetUpText" Text="0 KB/s" Style="{StaticResource TileDetail}" />
                        </StackPanel>
                    </Viewbox>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource PanelSplitterStyle}"
                          ResizeDirection="Rows" ToolTip="Arrastra para cambiar la altura del monitor" />

            <GridSplitter Grid.Row="3" Grid.Column="1" Style="{StaticResource VPanelSplitterStyle}"
                          ResizeDirection="Columns" ToolTip="Arrastra para cambiar el ancho del reproductor" />

            <!-- Centro: accesos | info -->
            <!-- Centro: cajas libres. Arrastra la cabecera para mover una caja y la esquina inferior derecha
                 para cambiar su tamano; clic derecho en el fondo: "Restablecer disposicion". Sin scroll:
                 lo que no cabe se recorta, agranda la caja para verlo. -->
            <ctl:DashboardBoard x:Name="CenterBoard" BoardId="dashboard" Columns="12" Rows="12"
                                Grid.Row="3" Grid.Column="0" Margin="0,0,0,14">

                <ctl:BoardBox ctl:DashboardBoard.Key="games" ctl:DashboardBoard.Col="0" ctl:DashboardBoard.Row="0"
                              ctl:DashboardBoard.ColSpan="7" ctl:DashboardBoard.RowSpan="6"
                              Title="[ JUEGOS ]" TitleTarget="games">
                    <Grid>
                        <ItemsControl x:Name="GamesItems" ItemTemplate="{StaticResource GameTileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:FluidTilePanel MinItemWidth="86" Spacing="10" HeightRatio="1.3" ExtraHeight="22" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock x:Name="GamesEmpty" Text="&gt; sin juegos_" Style="{StaticResource SectionTitle}"
                                   Visibility="Collapsed" />
                    </Grid>
                </ctl:BoardBox>

                <ctl:BoardBox ctl:DashboardBoard.Key="commands" ctl:DashboardBoard.Col="0" ctl:DashboardBoard.Row="6"
                              ctl:DashboardBoard.ColSpan="7" ctl:DashboardBoard.RowSpan="3"
                              Title="[ COMANDOS ]" TitleTarget="commands">
                    <ItemsControl x:Name="CommandsItems" ItemTemplate="{StaticResource IconTileTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><ctl:FitPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ctl:BoardBox>

                <ctl:BoardBox ctl:DashboardBoard.Key="folders" ctl:DashboardBoard.Col="0" ctl:DashboardBoard.Row="9"
                              ctl:DashboardBoard.ColSpan="7" ctl:DashboardBoard.RowSpan="3"
                              Title="[ CARPETAS ]" TitleTarget="folders">
                    <ItemsControl x:Name="FoldersItems" ItemTemplate="{StaticResource GameTileTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:FluidTilePanel MinItemWidth="86" Spacing="10" HeightRatio="1.3" ExtraHeight="22" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ctl:BoardBox>

                <ctl:BoardBox ctl:DashboardBoard.Key="log" ctl:DashboardBoard.Col="7" ctl:DashboardBoard.Row="0"
                              ctl:DashboardBoard.ColSpan="5" ctl:DashboardBoard.RowSpan="6"
                              Title="[ REGISTRO ]">
                    <ctl:BoardBox.HeaderExtra>
                        <Button x:Name="LogToggleButton" Content="ver todo" Style="{StaticResource LinkButton}"
                                Click="LogToggle_Click" />
                    </ctl:BoardBox.HeaderExtra>
                    <Grid>
                        <ItemsControl x:Name="LogItems" ItemTemplate="{StaticResource LogRowTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><ctl:FitPanel Orientation="Vertical" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock x:Name="LogEmpty" Text="&gt; sin eventos_" Style="{StaticResource SectionTitle}"
                                   Visibility="Collapsed" />
                    </Grid>
                </ctl:BoardBox>

                <ctl:BoardBox ctl:DashboardBoard.Key="uplink" ctl:DashboardBoard.Col="7" ctl:DashboardBoard.Row="6"
                              ctl:DashboardBoard.ColSpan="5" ctl:DashboardBoard.RowSpan="6"
                              Title="[ UPLINK ]" TitleTarget="devices">
                    <Grid>
                        <ItemsControl x:Name="UplinkItems" ItemTemplate="{StaticResource UplinkRowTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><ctl:FitPanel Orientation="Vertical" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock x:Name="UplinkEmpty" Text="&gt; sin dispositivos externos_"
                                   Style="{StaticResource SectionTitle}" Visibility="Collapsed" />
                    </Grid>
                </ctl:BoardBox>

            </ctl:DashboardBoard>

            <!-- Barra inferior: procesos -->
            <StackPanel Grid.Row="4" Grid.ColumnSpan="3">
                <Button Content="[ PROCESOS ]" svc:Navigator.To="processes" Style="{StaticResource SectionLink}" Margin="0,0,0,8" />
                <ItemsControl x:Name="ProcItems" ItemTemplate="{StaticResource ProcCellTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" Columns="5" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

        <!-- ===================== REPRODUCTOR ===================== -->
        <Border x:Name="PlayerPanel" Grid.Row="3" Grid.Column="2" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0"
                Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Content="[ MULTIMEDIA ]" svc:Navigator.To="media" Style="{StaticResource SectionLink}"
                        Margin="0,0,0,10" />

                <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Center">
                <StackPanel Width="190"
                            Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}">
                    <Border Width="190" Height="190" CornerRadius="10" ClipToBounds="True" HorizontalAlignment="Center">
                        <Border.Background>
                            <RadialGradientBrush>
                                <GradientStop Color="{DynamicResource Color.AccentDim}" Offset="0" />
                                <GradientStop Color="{DynamicResource Color.Surface}" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                        <Grid>
                            <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource Font.Icons}" FontSize="48"
                                       Foreground="{DynamicResource Brush.Accent}" Opacity="0.5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasAlbumArt, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                            <Image Source="{Binding AlbumArt}" Stretch="UniformToFill"
                                   Visibility="{Binding HasAlbumArt, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding Title}" Margin="0,16,0,0" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Artist}" Margin="0,3,0,0" FontSize="12"
                               Foreground="{DynamicResource Brush.TextSecondary}" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <Border Style="{StaticResource BadgeStyle}" Margin="0,8,0,0" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SourceApp}" FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                   Foreground="{DynamicResource Brush.Accent}" />
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding PositionText}" FontFamily="{DynamicResource Font.Mono}"
                                   FontSize="10" Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" />
                        <Slider x:Name="ProgressSlider" Grid.Column="1" Margin="8,0" Minimum="0"
                                Style="{StaticResource MinimalSliderStyle}"
                                PreviewMouseLeftButtonDown="ProgressSlider_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="ProgressSlider_PreviewMouseLeftButtonUp" />
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontFamily="{DynamicResource Font.Mono}"
                                   FontSize="10" Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Content="&#xE892;" Style="{StaticResource TransportButtonStyle}" Margin="0,0,12,0"
                                ToolTip="Anterior" Click="Previous_Click" />
                        <Button Content="{Binding IsPlaying, Converter={StaticResource PlayPauseGlyph}}"
                                Style="{StaticResource PlayButtonStyle}" Click="PlayPause_Click" />
                        <Button Content="&#xE893;" Style="{StaticResource TransportButtonStyle}" Margin="12,0,0,0"
                                ToolTip="Siguiente" Click="Next_Click" />
                    </StackPanel>
                </StackPanel>
                </Viewbox>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                    <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource Font.Icons}" FontSize="34"
                               Foreground="{DynamicResource Brush.TextDim}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="&gt; nada reproduciendose_" FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                               Foreground="{DynamicResource Brush.TextDim}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scanlines por encima de todo (efecto CRT sutil) -->
        <Rectangle Grid.ColumnSpan="3" Grid.RowSpan="5" Fill="{StaticResource Bg.Scanlines}" IsHitTestVisible="False" />
    </Grid>
</UserControl>
