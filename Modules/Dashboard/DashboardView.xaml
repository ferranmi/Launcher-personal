<UserControl x:Class="Launcher.Modules.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Launcher.Core.Converters">

    <UserControl.Resources>
        <conv:PathToBitmapConverter x:Key="PathToBitmap" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:PlayPauseGlyphConverter x:Key="PlayPauseGlyph" />

        <!-- ===================== TEXTOS DE SECCION ===================== -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
        </Style>

        <Style x:Key="SectionLink" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tarjeta clicable (carpetas, comandos, juegos) -->
        <Style x:Key="TileStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===================== BARRA DE PROGRESO ===================== -->
        <Style x:Key="DashBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Rectangle x:Name="PART_Indicator"
                                           Fill="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Left"
                                           RadiusX="3" RadiusY="3" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource MetricLabel}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <!-- ===================== REPRODUCTOR COMPACTO ===================== -->
        <Style x:Key="MiniTransport" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Icons}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniPlay" TargetType="Button" BasedOn="{StaticResource MiniTransport}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="Foreground" Value="#FF07130D" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- ===================== PROCESOS: CABECERAS Y VALORES ===================== -->
        <!-- La cabecera de cada metrica es un RadioButton: elegirla ordena la lista. -->
        <Style x:Key="MetricHeader" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Arrow" Text="&#x25BE;" Margin="0,0,3,0" Visibility="Collapsed"
                                       Foreground="{DynamicResource Brush.Accent}" />
                            <ContentPresenter />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProcValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ProcValueCpu" TargetType="TextBlock" BasedOn="{StaticResource ProcValue}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCpu}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProcValueRam" TargetType="TextBlock" BasedOn="{StaticResource ProcValue}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRam}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProcValueGpu" TargetType="TextBlock" BasedOn="{StaticResource ProcValue}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGpu}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,6,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===================== CABECERA: titulo, buscador, fecha ===================== -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="&gt; inicio_"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="14"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           VerticalAlignment="Center" />

                <!-- Hueco para el futuro buscador unificado (modulo Buscar). -->
                <TextBox Grid.Column="1" x:Name="SearchBox" Style="{StaticResource TextBoxStyle}"
                         Tag="buscar... (proximamente)" IsEnabled="False" Opacity="0.6"
                         MaxWidth="420" Margin="24,0" />

                <TextBlock Grid.Column="2" x:Name="DateText"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                           Foreground="{DynamicResource Brush.TextDim}"
                           VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <!-- ============================================================= -->
                <!-- COLUMNA IZQUIERDA: accesos (juegos, carpetas, comandos)        -->
                <!-- ============================================================= -->
                <StackPanel Grid.Column="0">

                    <!-- JUEGOS -->
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="JUEGOS" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="ver todo &#x203A;" Style="{StaticResource SectionLink}"
                                   Tag="games" HorizontalAlignment="Right"
                                   MouseLeftButtonUp="SectionLink_Click" />
                    </Grid>
                    <ItemsControl x:Name="GamesItems" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TileStyle}" Width="96" Margin="0,0,10,10"
                                        ToolTip="{Binding Name}"
                                        MouseLeftButtonUp="GameTile_Click">
                                    <StackPanel>
                                        <Grid Height="128">
                                            <Border CornerRadius="7,7,0,0" ClipToBounds="True">
                                                <Grid>
                                                    <Border Background="{DynamicResource Brush.SurfaceActive}"
                                                            Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                                        <TextBlock Text="{Binding Initial}"
                                                                   FontFamily="{DynamicResource Font.Mono}"
                                                                   FontSize="34" FontWeight="Bold"
                                                                   Foreground="{DynamicResource Brush.TextDim}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Image Source="{Binding CoverImagePath, Converter={StaticResource PathToBitmap}}"
                                                           Stretch="UniformToFill"
                                                           Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" Margin="8,6,8,8"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="GamesEmpty" Text="&gt; sin juegos todavia_" Margin="0,0,0,12"
                               FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                               Foreground="{DynamicResource Brush.TextDim}" Visibility="Collapsed" />

                    <!-- CARPETAS -->
                    <Grid Margin="0,6,0,10">
                        <TextBlock Text="CARPETAS" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="ver todo &#x203A;" Style="{StaticResource SectionLink}"
                                   Tag="folders" HorizontalAlignment="Right"
                                   MouseLeftButtonUp="SectionLink_Click" />
                    </Grid>
                    <ItemsControl x:Name="FoldersItems" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TileStyle}" Width="96" Height="82" Margin="0,0,10,10"
                                        ToolTip="{Binding Path}"
                                        MouseLeftButtonUp="FolderTile_Click">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}"
                                                   FontFamily="{DynamicResource Font.Icons}" FontSize="22"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Accent}" />
                                        <TextBlock Text="{Binding Name}" Margin="0,7,0,0"
                                                   FontSize="11" MaxWidth="84" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                                        <TextBlock Text="no encontrada" Margin="0,2,0,0"
                                                   FontFamily="{DynamicResource Font.Mono}" FontSize="9"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Danger}"
                                                   Visibility="{Binding Exists, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="FoldersEmpty" Text="&gt; sin carpetas_" Margin="0,0,0,12"
                               FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                               Foreground="{DynamicResource Brush.TextDim}" Visibility="Collapsed" />

                    <!-- COMANDOS -->
                    <Grid Margin="0,6,0,10">
                        <TextBlock Text="COMANDOS" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="ver todo &#x203A;" Style="{StaticResource SectionLink}"
                                   Tag="commands" HorizontalAlignment="Right"
                                   MouseLeftButtonUp="SectionLink_Click" />
                    </Grid>
                    <ItemsControl x:Name="CommandsItems" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TileStyle}" Width="96" Height="82" Margin="0,0,10,10"
                                        ToolTip="{Binding Name}"
                                        MouseLeftButtonUp="CommandTile_Click">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border Width="34" Height="34" CornerRadius="8"
                                                Background="{DynamicResource Brush.AccentDim}"
                                                HorizontalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="{Binding Icon}"
                                                           FontFamily="{DynamicResource Font.Icons}" FontSize="16"
                                                           Foreground="{DynamicResource Brush.Accent}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding HasImageIcon, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                                <Image Source="{Binding IconImagePath, Converter={StaticResource PathToBitmap}}"
                                                       Width="22" Height="22" Stretch="Uniform"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding HasImageIcon, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Margin="0,7,0,0"
                                                   FontSize="11" MaxWidth="84" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="CommandsEmpty" Text="&gt; sin comandos_" Margin="0,0,0,12"
                               FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                               Foreground="{DynamicResource Brush.TextDim}" Visibility="Collapsed" />
                </StackPanel>

                <!-- ============================================================= -->
                <!-- COLUMNA DERECHA: informacion en vivo                           -->
                <!-- ============================================================= -->
                <StackPanel Grid.Column="2">

                    <!-- SISTEMA (version reducida de Monitor) -->
                    <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="SISTEMA" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="ver todo &#x203A;" Style="{StaticResource SectionLink}"
                                           Tag="monitor" HorizontalAlignment="Right"
                                           MouseLeftButtonUp="SectionLink_Click" />
                            </Grid>

                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CPU" Style="{StaticResource MetricLabel}" />
                                <ProgressBar Grid.Column="1" x:Name="CpuBar" Style="{StaticResource DashBar}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" x:Name="CpuValue" Text="--" Margin="8,0,0,0" Style="{StaticResource MetricValue}" />
                            </Grid>

                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="RAM" Style="{StaticResource MetricLabel}" />
                                <ProgressBar Grid.Column="1" x:Name="RamBar" Style="{StaticResource DashBar}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" x:Name="RamValue" Text="--" Margin="8,0,0,0" Style="{StaticResource MetricValue}" />
                            </Grid>

                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="GPU" Style="{StaticResource MetricLabel}" />
                                <ProgressBar Grid.Column="1" x:Name="GpuBar" Style="{StaticResource DashBar}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" x:Name="GpuValue" Text="--" Margin="8,0,0,0" Style="{StaticResource MetricValue}" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="VRAM" Style="{StaticResource MetricLabel}" />
                                <ProgressBar Grid.Column="1" x:Name="VramBar" Style="{StaticResource DashBar}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" x:Name="VramValue" Text="--" Margin="8,0,0,0" Style="{StaticResource MetricValue}" />
                            </Grid>

                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="NetText" Text="&#x2193; --   &#x2191; --"
                                               FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                    <TextBlock x:Name="DrivesText" Margin="0,4,0,0" TextWrapping="Wrap"
                                               FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                    <TextBlock x:Name="UptimeText" Margin="0,4,0,0"
                                               FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                                               Foreground="{DynamicResource Brush.TextDim}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- REPRODUCIENDO -->
                    <Border x:Name="NowPlayingCard" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="REPRODUCIENDO" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="ver todo &#x203A;" Style="{StaticResource SectionLink}"
                                           Tag="media" HorizontalAlignment="Right"
                                           MouseLeftButtonUp="SectionLink_Click" />
                            </Grid>

                            <StackPanel Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="56" Height="56" CornerRadius="6" ClipToBounds="True"
                                            Background="{DynamicResource Brush.AccentDim}">
                                        <Grid>
                                            <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource Font.Icons}" FontSize="22"
                                                       Foreground="{DynamicResource Brush.Accent}" Opacity="0.6"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding HasAlbumArt, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                            <Image Source="{Binding AlbumArt}" Stretch="UniformToFill"
                                                   Visibility="{Binding HasAlbumArt, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                                        <TextBlock Text="{Binding Artist}" Margin="0,2,0,0" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                        <TextBlock Text="{Binding SourceApp}" Margin="0,3,0,0"
                                                   FontFamily="{DynamicResource Font.Mono}" FontSize="9.5"
                                                   Foreground="{DynamicResource Brush.TextDim}" />
                                    </StackPanel>
                                </Grid>

                                <ProgressBar Margin="0,12,0,0" Height="4" Style="{StaticResource DashBar}"
                                             Maximum="{Binding DurationSeconds}"
                                             Value="{Binding PositionSeconds, Mode=OneWay}" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                    <Button Content="&#xE892;" Style="{StaticResource MiniTransport}" Margin="0,0,10,0"
                                            ToolTip="Anterior" Click="Previous_Click" />
                                    <Button Content="{Binding IsPlaying, Converter={StaticResource PlayPauseGlyph}}"
                                            Style="{StaticResource MiniPlay}" Click="PlayPause_Click" />
                                    <Button Content="&#xE893;" Style="{StaticResource MiniTransport}" Margin="10,0,0,0"
                                            ToolTip="Siguiente" Click="Next_Click" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="&gt; nada reproduciendose_"
                                       FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                                       Foreground="{DynamicResource Brush.TextDim}"
                                       Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </Border>

                    <!-- PROCESOS (top 5) -->
                    <Border Style="{StaticResource CardStyle}" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="PROCESOS" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="ver todo &#x203A;" Style="{StaticResource SectionLink}"
                                           Tag="processes" HorizontalAlignment="Right"
                                           MouseLeftButtonUp="SectionLink_Click" />
                            </Grid>

                            <!-- Cabeceras: elegir una ordena el top 5 por esa metrica -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="mayor consumo" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                           Foreground="{DynamicResource Brush.TextDim}" />
                                <RadioButton Grid.Column="1" Content="CPU" Tag="Cpu" GroupName="ProcMetric"
                                             Style="{StaticResource MetricHeader}" IsChecked="True"
                                             Checked="Metric_Checked" />
                                <RadioButton Grid.Column="2" Content="RAM" Tag="Ram" GroupName="ProcMetric"
                                             Style="{StaticResource MetricHeader}" Checked="Metric_Checked" />
                                <RadioButton Grid.Column="3" Content="GPU" Tag="Gpu" GroupName="ProcMetric"
                                             Style="{StaticResource MetricHeader}" Checked="Metric_Checked" />
                            </Grid>

                            <ItemsControl x:Name="TopProcessesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="52" />
                                            </Grid.ColumnDefinitions>

                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                                                <TextBlock Grid.Column="2" Text="{Binding CountLabel}" Margin="5,0,0,0"
                                                           FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.TextDim}" />
                                            </Grid>

                                            <TextBlock Grid.Column="1" Text="{Binding CpuText}" Style="{StaticResource ProcValueCpu}" />
                                            <TextBlock Grid.Column="2" Text="{Binding RamText}" Style="{StaticResource ProcValueRam}" />
                                            <TextBlock Grid.Column="3" Text="{Binding GpuText}" Style="{StaticResource ProcValueGpu}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
