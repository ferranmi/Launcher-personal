<Application x:Class="Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Sin StartupUri: App.OnStartup crea y muestra MainWindow a mano (despues de
         comprobar la instancia unica). Con StartupUri se abririan dos ventanas. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="UI/Themes/Theme.Dark.xaml" />
                <ResourceDictionary Source="UI/Themes/Shared.Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
