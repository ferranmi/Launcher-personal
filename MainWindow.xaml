<Window x:Class="Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Launcher.UI.Controls"
        Title="Launcher"
        Height="720" Width="1180"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Border Background="{DynamicResource Brush.Background}"
            CornerRadius="12"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="0" Opacity="0.6" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===================== TITLE BAR ===================== -->
            <Grid x:Name="TitleBar" Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border Width="7" Height="7" CornerRadius="1"
                            Background="{DynamicResource Brush.Accent}"
                            Effect="{DynamicResource Effect.AccentGlow}" />
                    <TextBlock Text="L A U N C H E R"
                               Margin="9,0,0,0"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               FontFamily="{DynamicResource Font.Mono}"
                               FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="&#xE921;" Style="{StaticResource WindowButtonStyle}" Click="Minimize_Click" />
                    <Button Content="&#xE8BB;" Style="{StaticResource WindowButtonStyle}" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- ===================== BODY ===================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
                        CornerRadius="0,0,0,12"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="NavPanel" Grid.Row="0" Margin="0,8,0,0" />
                        <TextBlock x:Name="VersionText" Grid.Row="1" Text="v0.1.0"
                                   Margin="20,0,0,14"
                                   FontFamily="{DynamicResource Font.Mono}"
                                   FontSize="10"
                                   Foreground="{DynamicResource Brush.TextDim}" />
                    </Grid>
                </Border>

                <!-- Content -->
                <Border Grid.Column="1" Background="{DynamicResource Brush.Background}">
                    <ContentControl x:Name="ContentArea" Margin="20" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
