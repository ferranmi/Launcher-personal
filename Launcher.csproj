<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.1.32g</Version>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Launcher</RootNamespace>
    <AssemblyName>Launcher</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\launcher.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>

    <!-- Main propio (Program.cs): Velopack debe ejecutarse antes que WPF. -->
    <StartupObject>Launcher.Program</StartupObject>
  </PropertyGroup>

  <!-- App.xaml pasa de ApplicationDefinition a Page para que WPF no genere su propio Main. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <!-- Evita ambiguedades entre WinForms/Drawing y WPF (UserControl, Brush, Button...). -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <Resource Include="Assets\launcher.ico" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="10.0.*" />
    <PackageReference Include="Microsoft.Playwright" Version="1.*" />
    <PackageReference Include="System.Data.OleDb" Version="9.0.0" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

</Project>
